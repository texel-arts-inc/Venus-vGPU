#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_mesh_shader : require
#include "shared.glsl"

layout(local_size_x = 6) in;
layout(triangles, max_vertices = 6, max_primitives = 2) out;

layout(std430, set = 0, binding = 0) readonly buffer Scene {
    Vertex vertices[];
};
layout(location = 0) out vec3 worldPosition[];
layout(location = 1) flat out vec3 normal[];
layout(location = 2) flat out vec4 material[];

void main() {
    SetMeshOutputsEXT(6, 2);
    uint localVertex = gl_LocalInvocationIndex;
    Vertex vertex = vertices[gl_WorkGroupID.x * 6 + localVertex];
    gl_MeshVerticesEXT[localVertex].gl_Position = project(vertex.position.xyz);
    worldPosition[localVertex] = vertex.position.xyz;
    normal[localVertex] = vertex.normal.xyz;
    material[localVertex] = vertex.material;
    if (localVertex < 2) {
        uint first = localVertex * 3;
        gl_PrimitiveTriangleIndicesEXT[localVertex] = uvec3(first, first + 1, first + 2);
    }
}
