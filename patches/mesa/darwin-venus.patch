+static bool
+darwin_bo_destroy(struct vn_renderer *renderer, struct vn_renderer_bo *bo)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct darwin_bo *vram_bo = (struct darwin_bo *)bo;
+   if (bo->mmap_ptr)
+      munmap(bo->mmap_ptr, bo->mmap_size);
+   rv_client_release_vram(&darwin->client, &vram_bo->lease);
+   vk_free(&darwin->instance->base.vk.alloc, bo);
+   return true;
+}
+
+static VkResult
+darwin_sync_create(struct vn_renderer *renderer, uint64_t initial_value,
+                   struct vn_renderer_sync **out_sync)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct darwin_sync *sync = vk_zalloc(
+      &darwin->instance->base.vk.alloc, sizeof(*sync), VN_DEFAULT_ALIGN,
+      VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!sync)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   uint32_t id = RV_CTL_MAX_SYNCS;
+   mtx_lock(&darwin->mutex);
+   for (uint32_t i = 0; i < RV_CTL_MAX_SYNCS; i++) {
+      if (!darwin->sync_used[i]) {
+         id = i;
+         darwin->sync_used[i] = true;
+         break;
+      }
+   }
+   mtx_unlock(&darwin->mutex);
+   if (id == RV_CTL_MAX_SYNCS) {
+      vk_free(&darwin->instance->base.vk.alloc, sync);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   if (rv_client_sync_lifecycle(&darwin->client, RV_CTL_CREATE_SYNC, id,
+                                initial_value)) {
+      mtx_lock(&darwin->mutex);
+      darwin->sync_used[id] = false;
+      mtx_unlock(&darwin->mutex);
+      vk_free(&darwin->instance->base.vk.alloc, sync);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   sync->base.sync_id = id;
+   sync->value = initial_value;
+   *out_sync = &sync->base;
+   return VK_SUCCESS;
+}
+
+static void
+darwin_sync_destroy(struct vn_renderer *renderer,
+                    struct vn_renderer_sync *_sync)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct darwin_sync *sync = (struct darwin_sync *)_sync;
+   mtx_lock(&darwin->mutex);
+   VkResult result = darwin_finish_fence_locked(darwin, sync, UINT32_MAX);
+   if (result == VK_SUCCESS &&
+       !rv_client_sync_lifecycle(&darwin->client, RV_CTL_DESTROY_SYNC,
+                                 sync->base.sync_id, 0))
+      darwin->sync_used[sync->base.sync_id] = false;
+   if (sync->pending_slot)
+      *sync->pending_slot = NULL;
+   mtx_unlock(&darwin->mutex);
+   vk_free(&darwin->instance->base.vk.alloc, sync);
+}
+
+static VkResult
+darwin_sync_reset(struct vn_renderer *renderer,
+                  struct vn_renderer_sync *_sync)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   if (darwin_is_lost(renderer))
+      return VK_ERROR_DEVICE_LOST;
+   struct darwin_sync *sync = (struct darwin_sync *)_sync;
+   mtx_lock(&darwin->mutex);
+   VkResult result = darwin_finish_fence_locked(darwin, sync, UINT32_MAX);
+   if (result == VK_SUCCESS && darwin->fence_epochs && _sync->is_fence &&
+       sync->fence_epoch < UINT64_MAX - 1) {
+      sync->fence_epoch++;
+      mtx_unlock(&darwin->mutex);
+      return VK_SUCCESS;
+   }
+   mtx_unlock(&darwin->mutex);
+   if (result != VK_SUCCESS)
+      return result;
+   if (rv_client_sync_lifecycle(&darwin->client, RV_CTL_DESTROY_SYNC,
+                                sync->base.sync_id, 0) ||
+       rv_client_sync_lifecycle(&darwin->client, RV_CTL_CREATE_SYNC,
+                                sync->base.sync_id, 0))
+      return VK_ERROR_DEVICE_LOST;
+   mtx_lock(&darwin->mutex);
+   sync->value = 0;
+   sync->fence_epoch = 0;
+   mtx_unlock(&darwin->mutex);
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_sync_read(struct vn_renderer *renderer,
+                 struct vn_renderer_sync *_sync, uint64_t *value)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   if (darwin_is_lost(renderer))
+      return VK_ERROR_DEVICE_LOST;
+   struct darwin_sync *sync = (struct darwin_sync *)_sync;
+   mtx_lock(&darwin->mutex);
+   if (sync->pending_slot) {
+      VkResult result = darwin_finish_fence_locked(darwin, sync, 0);
+      *value = sync->value > sync->fence_epoch;
+      mtx_unlock(&darwin->mutex);
+      return result == VK_TIMEOUT ? VK_SUCCESS : result;
+   }
+   mtx_unlock(&darwin->mutex);
+   if (rv_client_sync_value(&darwin->client, RV_CTL_READ_SYNC,
+                            sync->base.sync_id, 0, value))
+      return VK_ERROR_DEVICE_LOST;
+   mtx_lock(&darwin->mutex);
+   if (*value > sync->value)
+      sync->value = *value;
+   if (_sync->is_fence)
+      *value = *value > sync->fence_epoch;
+   mtx_unlock(&darwin->mutex);
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_sync_write(struct vn_renderer *renderer,
+                  struct vn_renderer_sync *_sync, uint64_t value)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct darwin_sync *sync = (struct darwin_sync *)_sync;
+   if (rv_client_sync_value(&darwin->client, RV_CTL_WRITE_SYNC,
+                            sync->base.sync_id, value, NULL))
+      return VK_ERROR_DEVICE_LOST;
+   mtx_lock(&darwin->mutex);
+   if (value <= sync->value) {
+      mtx_unlock(&darwin->mutex);
+      return VK_ERROR_DEVICE_LOST;
+   }
+   sync->value = value;
+   mtx_unlock(&darwin->mutex);
+   return VK_SUCCESS;
+}
+
+static bool
+darwin_option(const char *name, bool default_value)
+{
+   const char *value = getenv(name);
+   return value ? !strcmp(value, "1") : default_value;
+}
+
+VkResult
+vn_renderer_create_darwin_ivshmem(struct vn_instance *instance,
+                                  const VkAllocationCallbacks *alloc,
+                                  struct vn_renderer **out_renderer)
+{
+   const char *socket_path = getenv("IVSHMEM_SOCKET");
+   const char *state_file = getenv("VENUS_RUNTIME_STATE");
+   const char *pm_socket = getenv("VENUS_PM_SOCKET");
+   const bool managed = (!socket_path || !socket_path[0]) && (!state_file || !state_file[0]);
+   struct rv_runtime_paths paths;
+   if (managed) {
+      const int error = rv_runtime_resolve(&paths, true);
+      if (error) {
+         mesa_loge("Venus managed runtime endpoints unavailable: %s", strerror(error));
+         return VK_ERROR_INITIALIZATION_FAILED;
+      }
+      pm_socket = paths.power;
+   }
+
+   struct darwin_renderer *darwin = vk_zalloc(
+      alloc, sizeof(*darwin), VN_DEFAULT_ALIGN,
+      VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!darwin)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   darwin->instance = instance;
+   mtx_init(&darwin->mutex, mtx_plain);
+   VkResult result = VK_ERROR_INITIALIZATION_FAILED;
+   RV_PM_SCOPE(pm);
+   if (pm_socket && pm_socket[0]) {
+      const int error = rv_pm_connect(pm_socket);
+      if (error) {
+         if (managed)
+            mesa_loge("Venus managed PM enrollment failed: %s", strerror(error));
+         goto fail;
+      }
+      darwin->power_control = true;
+      if (rv_pm_enter(&pm, RV_PM_INFINITE)) {
+         if (managed)
+            mesa_loge("Venus managed PM coordinator unavailable after enrollment");
+         goto fail;
+      }
+   }
+   int open_result;
+   if (managed)
+      open_result = rv_client_open_paths(&darwin->client, paths.doorbell, paths.pool,
+                                         25000, true, true);
+   else if (state_file && state_file[0])
+      open_result = rv_client_open_runtime(&darwin->client, state_file, 25000);
+   else
+      open_result = rv_client_open(&darwin->client, socket_path, 25000);
+   if (open_result) {
+      if (managed) {
+         const int error = errno;
+         if (error == EPROTONOSUPPORT)
+            mesa_loge("Venus managed guest does not advertise async GPU waits");
+         else if (error == ENOTSUP)
+            mesa_loge("Venus managed guest does not advertise ordered pipelined streams");
+         else
+            mesa_loge("Venus managed IVSHMEM transport initialization failed: %s", strerror(error));
+      }
+      goto fail;
+   }
+   if (managed && !rv_transport_has_async_wait(darwin->client.session->transport)) {
+      mesa_loge("Venus managed async GPU wait transport is unavailable");
+      goto fail;
+   }
+   if (managed && !darwin->client.has_guest_vram) {
+      mesa_loge("Venus managed guest VRAM pool failed the shared allocation handshake");
+      goto fail;
+   }
+
+   const struct virgl_renderer_capset_venus *caps = &darwin->client.capset;
+   if (!caps->supports_blob_id_0 || !caps->allow_vk_wait_syncs ||
+       !caps->supports_multiple_timelines) {
+      if (managed)
+         mesa_loge("Venus managed guest lacks required Venus blob or timeline support");
+      goto fail;
+   }
+
+   darwin->base.info.has_dma_buf_import = false;
+   darwin->base.info.has_external_sync = false;
+   /* Keep timeline semaphores in the guest Vulkan driver. Waiting on a
+    * transport fence for every queue signal serializes submission and
+    * prevents a later submission from satisfying a pending timeline wait.
+    * The device-only path still supports host queries and waits.
+    */
+   darwin->base.info.has_timeline_sync = false;
+   darwin->base.info.has_implicit_fencing = false;
+   darwin->base.info.managed = managed;
+   darwin->async_fences = managed || darwin_option("VENUS_ASYNC_FENCES", false);
+   darwin->fence_epochs = managed || darwin_option("VENUS_FENCE_EPOCHS", false);
+   darwin->pipeline_streams = managed || darwin_option("VENUS_PIPELINE_STREAMS", false);
+   darwin->base.info.queue_submit_ordered =
+      managed || darwin_option("VENUS_SKIP_QUEUE_ROUNDTRIP", false);
+   darwin->base.info.async_metal_present =
+      managed || darwin_option("VENUS_ASYNC_METAL_PRESENT", false);
+   darwin->base.info.late_metal_drawable =
+      managed || darwin_option("VENUS_METAL_LATE_DRAWABLE", false);
+   darwin->base.info.has_guest_vram = darwin->client.has_guest_vram;
+   darwin->base.info.max_timeline_count = RV_CTL_MAX_QUEUES;
+   darwin->base.info.wire_format_version = caps->wire_format_version;
+   darwin->base.info.vk_xml_version = caps->vk_xml_version;
+   darwin->base.info.vk_ext_command_serialization_spec_version =
+      caps->vk_ext_command_serialization_spec_version;
+   darwin->base.info.vk_mesa_venus_protocol_spec_version =
+      caps->vk_mesa_venus_protocol_spec_version;
+   memcpy(darwin->base.info.vk_extension_mask, caps->vk_extension_mask1,
+          sizeof(caps->vk_extension_mask1));
+
+   vn_renderer_shmem_cache_init(&darwin->shmem_cache, &darwin->base,
+                                darwin_shmem_destroy_now);
+   darwin->base.ops.destroy = darwin_destroy;
+   darwin->base.ops.is_lost = darwin_is_lost;
+   darwin->base.ops.mark_lost = darwin_mark_lost;
+   darwin->base.ops.submit = darwin_submit;
+   if (darwin->pipeline_streams)
+      darwin->base.ops.wait_queue_decode = darwin_wait_queue_decode;
+   darwin->base.ops.wait = darwin_wait;
+   darwin->base.shmem_ops.create = darwin_shmem_create;
+   darwin->base.shmem_ops.destroy = darwin_shmem_destroy;
+   darwin->base.bo_ops.create_from_device_memory =
+      darwin_bo_create_from_device_memory;
+   darwin->base.bo_ops.create_from_dma_buf = NULL;
+   darwin->base.bo_ops.destroy = darwin_bo_destroy;
+   darwin->base.bo_ops.export_dma_buf = NULL;
+   darwin->base.bo_ops.export_sync_file = NULL;
+   darwin->base.bo_ops.map = darwin_bo_map;
+   darwin->base.bo_ops.flush = darwin_bo_flush;
+   darwin->base.bo_ops.invalidate = darwin_bo_invalidate;
+   darwin->base.sync_ops.create = darwin_sync_create;
+   darwin->base.sync_ops.create_from_syncobj = NULL;
+   darwin->base.sync_ops.destroy = darwin_sync_destroy;
+   darwin->base.sync_ops.export_syncobj = NULL;
+   darwin->base.sync_ops.reset = darwin_sync_reset;
+   darwin->base.sync_ops.read = darwin_sync_read;
+   darwin->base.sync_ops.write = darwin_sync_write;
+
+   *out_renderer = &darwin->base;
+   return VK_SUCCESS;
+
+fail:
+   rv_client_close(&darwin->client);
+   rv_pm_leave(&pm);
+   if (darwin->power_control)
+      rv_pm_disconnect();
+   mtx_destroy(&darwin->mutex);
+   vk_free(alloc, darwin);
+   return result;
+}
