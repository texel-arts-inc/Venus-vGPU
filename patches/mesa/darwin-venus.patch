+static bool
+vn_encode_descriptor_write(struct vn_cs_encoder *enc,
+                           const VkWriteDescriptorSet *write)
+{
+   if (write->pNext)
+      return false;
+
+   VkWriteDescriptorSet clean = {
+      .sType = write->sType,
+      .dstSet = write->dstSet,
+      .dstBinding = write->dstBinding,
+      .dstArrayElement = write->dstArrayElement,
+      .descriptorCount = write->descriptorCount,
+      .descriptorType = write->descriptorType,
+   };
+   const VkDescriptorImageInfo *images = NULL;
+   bool ignore_sampler = true;
+   bool ignore_view = false;
+   size_t element_size;
+   uint32_t count;
+   switch (write->descriptorType) {
+   case VK_DESCRIPTOR_TYPE_SAMPLER:
+      ignore_view = true;
+      FALLTHROUGH;
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER: {
+      const struct vn_descriptor_set *set =
+         vn_descriptor_set_from_handle(write->dstSet);
+      ignore_sampler =
+         set->layout->bindings[write->dstBinding].has_immutable_samplers;
+      FALLTHROUGH;
+   }
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+   case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+      images = write->pImageInfo;
+      count = images ? write->descriptorCount : 0;
+      element_size = vn_sizeof_VkDescriptorImageInfo(&(VkDescriptorImageInfo){0});
+      break;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+      clean.pBufferInfo = write->pBufferInfo;
+      count = clean.pBufferInfo ? write->descriptorCount : 0;
+      element_size = vn_sizeof_VkDescriptorBufferInfo(&(VkDescriptorBufferInfo){0});
+      break;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      clean.pTexelBufferView = write->pTexelBufferView;
+      count = clean.pTexelBufferView ? write->descriptorCount : 0;
+      element_size = vn_sizeof_VkBufferView(&(VkBufferView){0});
+      break;
+   default:
+      return false;
+   }
+
+   const size_t header_size =
+      vn_sizeof_VkWriteDescriptorSet(&(VkWriteDescriptorSet){0});
+   const size_t space = (const char *)enc->end - (const char *)enc->cur;
+   if (space < header_size || count > (space - header_size) / element_size)
+      return false;
+
+   if (!images) {
+      vn_encode_VkWriteDescriptorSet(enc, &clean);
+      return true;
+   }
+
+   assert(write->sType == VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET);
+   vn_encode_VkStructureType(enc, &clean.sType);
+   vn_encode_simple_pointer(enc, NULL);
+   vn_encode_VkDescriptorSet(enc, &clean.dstSet);
+   vn_encode_uint32_t(enc, &clean.dstBinding);
+   vn_encode_uint32_t(enc, &clean.dstArrayElement);
+   vn_encode_uint32_t(enc, &clean.descriptorCount);
+   vn_encode_VkDescriptorType(enc, &clean.descriptorType);
+   vn_encode_array_size(enc, count);
+   for (uint32_t i = 0; i < count; i++) {
+      const VkDescriptorImageInfo image = {
+         .sampler = ignore_sampler ? VK_NULL_HANDLE : images[i].sampler,
+         .imageView = ignore_view ? VK_NULL_HANDLE : images[i].imageView,
+         .imageLayout = ignore_view ? VK_IMAGE_LAYOUT_UNDEFINED : images[i].imageLayout,
+      };
+      vn_encode_VkDescriptorImageInfo(enc, &image);
+   }
+   vn_encode_array_size(enc, 0);
+   vn_encode_array_size(enc, 0);
+   return true;
+}
+
+static bool
+vn_submit_descriptor_writes(struct vn_ring *ring, VkDevice device,
+                            uint32_t count, const VkWriteDescriptorSet *writes)
+{
+   uint32_t data[1024];
+   struct vn_ring_submit_command submit;
+   struct vn_cs_encoder *enc =
+      vn_ring_submit_command_init(ring, &submit, data,
+                                  sizeof(data) - vn_sizeof_uint32_t(NULL) -
+                                     vn_sizeof_array_size(0), 0);
+   vn_encode_VkCommandTypeEXT(enc,
+      &(VkCommandTypeEXT){VK_COMMAND_TYPE_vkUpdateDescriptorSets_EXT});
+   vn_encode_VkFlags(enc, &(VkFlags){0});
+   vn_encode_VkDevice(enc, &device);
+   vn_encode_uint32_t(enc, &count);
+   vn_encode_array_size(enc, count);
+   for (uint32_t i = 0; i < count; i++) {
+      if (!vn_encode_descriptor_write(enc, &writes[i]))
+         return false;
+   }
+   enc->end = (const char *)data + sizeof(data);
+   vn_encode_uint32_t(enc, &(uint32_t){0});
+   vn_encode_array_size(enc, 0);
+   vn_ring_submit_command(ring, &submit);
+   return true;
+}
