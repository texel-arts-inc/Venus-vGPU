+#include "rv_runtime.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pwd.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static bool
+owned_mode(const struct stat *status, mode_t type, mode_t mode)
+{
+   return status->st_uid == geteuid() && (status->st_mode & S_IFMT) == type &&
+          (status->st_mode & 07777) == mode;
+}
+
+static int
+read_directory(int support, char directory[PATH_MAX])
+{
+   int fd = openat(support, "runtime", O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+   if (fd < 0)
+      return errno;
+   struct stat status;
+   int error = 0;
+   if (fstat(fd, &status)) {
+      error = errno;
+   } else if (!owned_mode(&status, S_IFREG, 0600) || status.st_size < 3 ||
+              status.st_size >= PATH_MAX) {
+      error = EINVAL;
+   } else {
+      size_t size = 0;
+      while (size < PATH_MAX) {
+         ssize_t count = read(fd, directory + size, PATH_MAX - size);
+         if (count < 0 && errno == EINTR)
+            continue;
+         if (count < 0) {
+            error = errno;
+            break;
+         }
+         if (!count)
+            break;
+         size += (size_t)count;
+      }
+      if (!error && (size < 3 || size >= PATH_MAX || directory[0] != '/' ||
+                     directory[size - 1] != '\n' || memchr(directory, '\0', size) ||
+                     memchr(directory, '\n', size - 1)))
+         error = EINVAL;
+      if (!error)
+         directory[size - 1] = '\0';
+   }
+   close(fd);
+   return error;
+}
+
+static int
+derive_path(int runtime, const char *directory, const char *leaf, char *out,
+            size_t capacity, bool socket)
+{
+   struct stat status;
+   if (fstatat(runtime, leaf, &status, AT_SYMLINK_NOFOLLOW))
+      return errno;
+   if (socket ? !(owned_mode(&status, S_IFSOCK, 0600) ||
+                  owned_mode(&status, S_IFSOCK, 0700))
+              : !owned_mode(&status, S_IFREG, 0600))
+      return EACCES;
+   int length = snprintf(out, capacity, "%s/%s", directory, leaf);
+   if (length < 0 || (size_t)length >= capacity ||
+       (socket && (size_t)length >= sizeof(((struct sockaddr_un *)0)->sun_path)))
+      return ENAMETOOLONG;
+   return 0;
+}
+
+int
+rv_runtime_read_at(int support, struct rv_runtime_paths *paths, bool derive_power)
+{
+   struct stat status;
+   if (fstat(support, &status))
+      return errno;
+   if (!owned_mode(&status, S_IFDIR, 0700))
+      return EACCES;
+   char directory[PATH_MAX];
+   int error = read_directory(support, directory);
+   if (error)
+      return error;
+
+   int runtime = open(directory, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+   if (runtime < 0)
+      return errno;
+   if (fstat(runtime, &status)) {
+      error = errno;
+   } else if (!owned_mode(&status, S_IFDIR, 0700)) {
+      error = EACCES;
+   } else {
+      paths->power[0] = '\0';
+      error = derive_path(runtime, directory, "doorbell.sock", paths->doorbell,
+                          sizeof(paths->doorbell), true);
+      if (!error)
+         error = derive_path(runtime, directory, "pool.ram", paths->pool,
+                             sizeof(paths->pool), false);
+      if (!error && derive_power)
+         error = derive_path(runtime, directory, "venus-pm.sock", paths->power,
+                             sizeof(paths->power), true);
+   }
+   close(runtime);
+   return error;
+}
+
+int
+rv_runtime_resolve(struct rv_runtime_paths *paths, bool derive_power)
+{
+   struct passwd user, *result;
+   char buffer[4096];
+   int error = getpwuid_r(geteuid(), &user, buffer, sizeof(buffer), &result);
+   if (error)
+      return error;
+   if (!result || user.pw_dir[0] != '/')
+      return ENOENT;
+   char support_path[PATH_MAX];
+   int length = snprintf(support_path, sizeof(support_path),
+                         "%s/Library/Application Support/Venus vGPU", user.pw_dir);
+   if (length < 0 || (size_t)length >= sizeof(support_path))
+      return ENAMETOOLONG;
+   int support = open(support_path, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+   if (support < 0)
+      return errno;
+   error = rv_runtime_read_at(support, paths, derive_power);
+   close(support);
+   return error;
+}
