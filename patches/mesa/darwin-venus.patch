+++ b/src/virtio/vulkan/reverse_venus/ivshmem.c
@@ -0,0 +1,259 @@
+#include "ivshmem.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+static bool message(int socket, int64_t *value, int *descriptor)
+{
+    size_t done = 0;
+    *descriptor = -1;
+    while (done < sizeof(*value)) {
+        union { struct cmsghdr align; char bytes[CMSG_SPACE(sizeof(int) * 2)]; } control;
+        struct iovec payload = { .iov_base = (char *)value + done, .iov_len = sizeof(*value) - done };
+        struct msghdr msg = { .msg_iov = &payload, .msg_iovlen = 1,
+                             .msg_control = control.bytes, .msg_controllen = sizeof(control.bytes) };
+        ssize_t count = recvmsg(socket, &msg, 0);
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (count <= 0)
+            break;
+
+        bool valid = !(msg.msg_flags & MSG_CTRUNC);
+        for (struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg); cmsg; cmsg = CMSG_NXTHDR(&msg, cmsg)) {
+            if (cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS)
+                continue;
+            const size_t descriptors = (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+            for (size_t i = 0; i < descriptors; ++i) {
+                int fd;
+                memcpy(&fd, CMSG_DATA(cmsg) + i * sizeof(fd), sizeof(fd));
+                if (*descriptor < 0 && fcntl(fd, F_SETFD, FD_CLOEXEC) == 0) {
+                    *descriptor = fd;
+                } else {
+                    close(fd);
+                    valid = false;
+                }
+            }
+        }
+        if (!valid)
+            break;
+        done += count;
+    }
+    if (done == sizeof(*value))
+        return true;
+    if (*descriptor >= 0)
+        close(*descriptor);
+    *descriptor = -1;
+    return false;
+}
+
+static bool update(struct rv_ivshmem *iv)
+{
+    int64_t peer;
+    int fd;
+    if (!message(iv->connection, &peer, &fd))
+        return false;
+    int *target = peer == iv->peer ? &iv->incoming :
+                  peer == iv->guest ? &iv->outgoing : NULL;
+    if (!target) {
+        if (fd >= 0)
+            close(fd);
+        return true;
+    }
+    if (*target >= 0)
+        close(*target);
+    *target = fd;
+    return fd >= 0;
+}
+
+static int remaining(uint64_t deadline)
+{
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    return now >= deadline ? 0 : (int)((deadline - now + 999999) / 1000000);
+}
+
+bool rv_iv_ring(struct rv_ivshmem *iv)
+{
+    const uint64_t one = 1;
+    ssize_t count;
+    do {
+        count = write(iv->outgoing, &one, sizeof(one));
+    } while (count < 0 && errno == EINTR);
+    return count == sizeof(one) || (count < 0 && errno == EAGAIN);
+}
+
+static bool wait_event(struct rv_ivshmem *iv, uint32_t timeout_ms, int stop_fd,
+                       pthread_mutex_t *lock)
+{
+    const uint64_t deadline = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) +
+                              (uint64_t)timeout_ms * UINT64_C(1000000);
+    do {
+        struct pollfd events[] = {
+            { .fd = iv->connection, .events = POLLIN },
+            { .fd = iv->incoming, .events = POLLIN },
+            { .fd = stop_fd, .events = POLLIN },
+        };
+        int count = poll(events, 3, stop_fd >= 0 ? -1 : remaining(deadline));
+        if (count < 0 && errno == EINTR)
+            continue;
+        if (!count)
+            break;
+        if (count < 0)
+            return false;
+        if (events[2].revents) {
+            errno = ECANCELED;
+            return false;
+        }
+        bool connected = !((events[0].revents | events[1].revents) &
+                           (POLLERR | POLLHUP | POLLNVAL));
+        if (connected && (events[0].revents & POLLIN)) {
+            if (lock)
+                pthread_mutex_lock(lock);
+            connected = update(iv);
+            if (lock)
+                pthread_mutex_unlock(lock);
+        }
+        if (!connected) {
+            errno = ENOTCONN;
+            return false;
+        }
+        if (events[1].revents & POLLIN && events[1].fd == iv->incoming) {
+            uint64_t kicks[8];
+            if (read(iv->incoming, kicks, sizeof(kicks)) > 0)
+                return true;
+        }
+    } while (stop_fd >= 0 || remaining(deadline));
+    errno = ETIMEDOUT;
+    return false;
+}
+
+bool rv_iv_wait_timeout(struct rv_ivshmem *iv, uint32_t timeout_ms)
+{
+    return wait_event(iv, timeout_ms, -1, NULL);
+}
+
+bool rv_iv_wait_interruptible(struct rv_ivshmem *iv, int stop_fd, pthread_mutex_t *lock)
+{
+    return wait_event(iv, 0, stop_fd, lock);
+}
+
+bool rv_iv_wait(struct rv_ivshmem *iv)
+{
+    return rv_iv_wait_timeout(iv, 25000);
+}
+
+void rv_iv_close(struct rv_ivshmem *iv)
+{
+    if (iv->aperture)
+        munmap(iv->aperture, iv->aperture_size);
+    if (iv->incoming >= 0)
+        close(iv->incoming);
+    if (iv->outgoing >= 0)
+        close(iv->outgoing);
+    if (iv->connection >= 0)
+        close(iv->connection);
+    if (iv->lock >= 0)
+        close(iv->lock);
+    *iv = (struct rv_ivshmem){ .connection = -1, .lock = -1, .incoming = -1, .outgoing = -1 };
+}
+
+bool rv_iv_open(struct rv_ivshmem *iv, const char *path, bool managed)
+{
+    struct sockaddr_un endpoint = { .sun_family = AF_UNIX };
+    if (!path || strlen(path) >= sizeof(endpoint.sun_path))
+        return false;
+    strcpy(endpoint.sun_path, path);
+
+    char lock_path[sizeof(endpoint.sun_path) + sizeof(".lock")];
+    snprintf(lock_path, sizeof(lock_path), "%s.lock", path);
+    iv->lock = open(lock_path, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (iv->lock < 0 || flock(iv->lock, LOCK_EX | LOCK_NB))
+        goto fail;
+
+    iv->connection = socket(AF_UNIX, SOCK_STREAM, 0);
+    const struct timeval timeout = { .tv_sec = 5 };
+    if (iv->connection < 0 ||
+        fcntl(iv->connection, F_SETFD, FD_CLOEXEC) ||
+        setsockopt(iv->connection, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+        connect(iv->connection, (const struct sockaddr *)&endpoint, sizeof(endpoint)))
+        goto fail;
+
+    int64_t fields[3];
+    for (unsigned i = 0; i < 3; ++i) {
+        int fd;
+        if (!message(iv->connection, &fields[i], &fd))
+            goto fail;
+        if (i != 2) {
+            if (fd >= 0) {
+                close(fd);
+                goto fail;
+            }
+            continue;
+        }
+        if (fd < 0)
+            goto fail;
+        struct stat st;
+        void *mapping = MAP_FAILED;
+        if (fields[0] == 0 && fields[1] >= 0 && fields[1] < UINT16_MAX &&
+            fields[2] == -1 && !fstat(fd, &st) &&
+            (st.st_size == RV_APERTURE_SIZE || st.st_size == RV_APERTURE_LARGE)) {
+            iv->aperture_size = (size_t)st.st_size;
+            mapping = mmap(NULL, iv->aperture_size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        }
+        close(fd);
+        if (mapping == MAP_FAILED)
+            goto fail;
+        iv->aperture = mapping;
+    }
+
+    iv->peer = (uint32_t)fields[1];
+    if (__atomic_load_n(&iv->aperture->ready, __ATOMIC_ACQUIRE) != RV_MAGIC)
+        goto fail;
+    if (managed && iv->aperture->gpu_wait_capability != RV_GPU_WAIT_CAPABILITY) {
+        errno = EPROTONOSUPPORT;
+        goto fail;
+    }
+    if (managed && iv->aperture->ordered_stream_capability != RV_ORDERED_STREAM_CAPABILITY) {
+        errno = ENOTSUP;
+        goto fail;
+    }
+    iv->guest = iv->aperture->guest_peer;
+    if (iv->guest >= UINT16_MAX || iv->guest == iv->peer)
+        goto fail;
+    const uint64_t deadline = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + UINT64_C(5000000000);
+    while (iv->incoming < 0 || iv->outgoing < 0) {
+        struct pollfd event = { .fd = iv->connection, .events = POLLIN };
+        if (poll(&event, 1, remaining(deadline)) <= 0 ||
+            event.revents & (POLLERR | POLLHUP | POLLNVAL) || !update(iv))
+            goto fail;
+    }
+    if (fcntl(iv->outgoing, F_SETNOSIGPIPE, 1) < 0)
+        goto fail;
+    do {
+        arc4random_buf(&iv->epoch, sizeof(iv->epoch));
+    } while (!iv->epoch);
+    iv->aperture->client_peer = iv->peer;
+    __atomic_store_n(&iv->aperture->client_epoch, iv->epoch, __ATOMIC_RELEASE);
+    if (!rv_iv_ring(iv) || !rv_iv_wait(iv) ||
+        __atomic_load_n(&iv->aperture->accepted_epoch, __ATOMIC_ACQUIRE) != iv->epoch)
+        goto fail;
+    return true;
+
+fail: {
+    const int error = errno;
+    rv_iv_close(iv);
+    errno = error;
+    return false;
+}
+}
