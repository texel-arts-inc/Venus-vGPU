+#define _DARWIN_C_SOURCE
+#include "rv_pm.h"
+#include "rv_transport.h"
+#include "ivshmem.h"
+#include "rv_control.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+struct rv_wait_queue {
+    pthread_cond_t cond;
+    unsigned sleepers;
+};
+
+enum {
+    RV_WAIT_RING_SPACE,
+    RV_WAIT_GPU_SPACE,
+    RV_WAIT_REQUEST_FIRST,
+    RV_WAIT_GPU_FIRST = RV_WAIT_REQUEST_FIRST + RV_RING_SIZE,
+    RV_WAIT_QUEUE_COUNT = RV_WAIT_GPU_FIRST + RV_GPU_WAIT_SLOTS,
+};
+
+struct rv_transport {
+    struct rv_ivshmem iv;
+    pthread_mutex_t lock;
+    pthread_mutex_t call_lock;
+    struct rv_wait_queue waits[RV_WAIT_QUEUE_COUNT];
+    pthread_t doorbell_thread;
+    int stop_pipe[2];
+    bool async_wait;
+    bool gpu_wait_busy[RV_GPU_WAIT_SLOTS];
+    uint32_t gpu_sleepers;
+    uint64_t posted;
+    uint64_t retired;
+    uint64_t kicked_through;
+    uint64_t observed_completed;
+    bool consumed[RV_RING_SIZE];
+    bool deferred[RV_RING_SIZE];
+    uint32_t timeout_ms;
+    int error;
+};
+
+_Static_assert(sizeof(struct rv_gpu_wait) == RV_GPU_WAIT_BYTES, "fence wait wire size");
+
+static void notify_waiters(struct rv_transport *transport, unsigned index)
+{
+    struct rv_wait_queue *queue = &transport->waits[index];
+    if (queue->sleepers)
+        pthread_cond_broadcast(&queue->cond);
+}
+
+static int transport_error(struct rv_transport *transport, int error)
+{
+    int old = 0;
+    __atomic_compare_exchange_n(&transport->error, &old, error, false,
+                                __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+    for (unsigned i = 0; i < RV_WAIT_QUEUE_COUNT; ++i)
+        notify_waiters(transport, i);
+    errno = error;
+    return -1;
+}
+
+static int current_error(const struct rv_transport *transport)
+{
+    return __atomic_load_n(&transport->error, __ATOMIC_RELAXED);
+}
+
+bool rv_transport_is_live(const struct rv_transport *transport)
+{
+    if (!transport || current_error(transport))
+        return false;
+    const struct rv_aperture *aperture = transport->iv.aperture;
+    return __atomic_load_n(&aperture->ready, __ATOMIC_ACQUIRE) == RV_MAGIC &&
+           __atomic_load_n(&aperture->accepted_epoch, __ATOMIC_ACQUIRE) ==
+                transport->iv.epoch;
+}
+
+void rv_transport_mark_lost(struct rv_transport *transport)
+{
+    if (transport) {
+        const int saved = errno;
+        pthread_mutex_lock(&transport->lock);
+        (void)transport_error(transport, ENODEV);
+        pthread_mutex_unlock(&transport->lock);
+        errno = saved;
+    }
+}
+
+static void retire_consumed(struct rv_transport *transport)
+{
+    const uint64_t previous = transport->retired;
+    while (transport->retired < transport->posted &&
+           transport->consumed[rv_slot(transport->retired + 1)])
+        ++transport->retired;
+    if (transport->retired != previous)
+        notify_waiters(transport, RV_WAIT_RING_SPACE);
+}
+
+static int collect_streams(struct rv_transport *transport)
+{
+    if (!rv_transport_is_live(transport))
+        return transport_error(transport, ENODEV);
+    struct rv_aperture *aperture = transport->iv.aperture;
+    const uint64_t completed = __atomic_load_n(&aperture->completed, __ATOMIC_ACQUIRE);
+    if (completed < transport->retired || completed > transport->posted)
+        return transport_error(transport, EPROTO);
+
+    for (uint64_t seq = transport->retired; seq < completed;) {
+        const size_t index = rv_slot(++seq);
+        if (!transport->deferred[index])
+            continue;
+        const struct rv_completion *completion = &aperture->replies[index];
+        if (completion->status || completion->bytes != sizeof(struct rv_ctl_reply))
+            return transport_error(transport, EIO);
+        struct rv_ctl_reply reply;
+        struct rv_stream_desc stream;
+        memcpy(&reply, completion->reply, sizeof(reply));
+        memcpy(&stream, aperture->requests[index].command, sizeof(stream));
+        if (reply.status || !reply.ticket ||
+            (stream.ring_idx && (!reply.resource_id || reply.resource_size != stream.ring_idx)))
+            return transport_error(transport, reply.status == RV_CTL_DEVICE_LOST ? ENODEV : EIO);
+        transport->deferred[index] = false;
+        transport->consumed[index] = true;
+    }
+    retire_consumed(transport);
+    return 0;
+}
+
+static int kick_locked(struct rv_transport *transport)
+{
+    if (!rv_iv_ring(&transport->iv))
+        return transport_error(transport, errno ? errno : EIO);
+    transport->kicked_through = transport->posted;
+    return 0;
+}
+
+static void receive_progress_locked(struct rv_transport *transport)
+{
+    struct rv_aperture *aperture = transport->iv.aperture;
+    const uint64_t completed = __atomic_load_n(&aperture->completed, __ATOMIC_ACQUIRE);
+    if (completed > transport->posted || completed < transport->observed_completed) {
+        transport_error(transport, EPROTO);
+        return;
+    }
+
+    uint64_t previous = transport->observed_completed;
+    if (completed - previous > RV_RING_SIZE)
+        previous = completed - RV_RING_SIZE;
+    while (previous < completed)
+        notify_waiters(transport, RV_WAIT_REQUEST_FIRST + rv_slot(++previous));
+    transport->observed_completed = completed;
+
+    for (uint32_t pending = transport->gpu_sleepers; pending; pending &= pending - 1) {
+        const unsigned i = __builtin_ctz(pending);
+        const unsigned index = RV_WAIT_GPU_FIRST + i;
+        const struct rv_gpu_wait_slot *slot = &aperture->gpu_waits[i];
+        if (__atomic_load_n(&slot->completed, __ATOMIC_ACQUIRE) ==
+            __atomic_load_n(&slot->requested, __ATOMIC_RELAXED))
+            notify_waiters(transport, index);
+    }
+
+    if (completed >= transport->kicked_through && completed < transport->posted)
+        (void)kick_locked(transport);
+}
+
+static void *receive_doorbells(void *data)
+{
+    struct rv_transport *transport = data;
+    while (rv_iv_wait_interruptible(&transport->iv, transport->stop_pipe[0],
+                                    &transport->lock)) {
+        pthread_mutex_lock(&transport->lock);
+        if (!current_error(transport) && !collect_streams(transport))
+            receive_progress_locked(transport);
+        pthread_mutex_unlock(&transport->lock);
+    }
+    const int error = errno;
+    if (error != ECANCELED) {
+        pthread_mutex_lock(&transport->lock);
+        transport_error(transport, error ? error : EIO);
+        pthread_mutex_unlock(&transport->lock);
+    }
+    return NULL;
+}
+
+static int start_doorbell_thread(struct rv_transport *transport)
+{
+    if (pipe(transport->stop_pipe))
+        return errno;
+    int error = 0;
+    if (fcntl(transport->stop_pipe[0], F_SETFD, FD_CLOEXEC) < 0 ||
+        fcntl(transport->stop_pipe[1], F_SETFD, FD_CLOEXEC) < 0)
+        error = errno;
+    else
+        error = pthread_create(&transport->doorbell_thread, NULL, receive_doorbells, transport);
+    if (error) {
+        close(transport->stop_pipe[0]);
+        close(transport->stop_pipe[1]);
+    }
+    return error;
+}
+
+int rv_transport_open(const struct rv_transport_config *config,
+                      struct rv_transport **out)
+{
+    if (!config || !out || !config->device_path) {
+        errno = EINVAL;
+        return -1;
+    }
+    *out = NULL;
+    struct rv_transport *transport = calloc(1, sizeof(*transport));
+    if (!transport)
+        return -1;
+    transport->iv = (struct rv_ivshmem){ .connection = -1, .lock = -1, .incoming = -1, .outgoing = -1 };
+    transport->timeout_ms = config->timeout_ms ? config->timeout_ms : 25000;
+
+    int error = pthread_mutex_init(&transport->lock, NULL);
+    if (error)
+        goto free_transport;
+    error = pthread_mutex_init(&transport->call_lock, NULL);
+    if (error)
+        goto destroy_lock;
+    unsigned initialized_waits = 0;
+    for (; initialized_waits < RV_WAIT_QUEUE_COUNT; ++initialized_waits) {
+        error = pthread_cond_init(&transport->waits[initialized_waits].cond, NULL);
+        if (error)
+            goto destroy_cond;
+    }
+    if (!rv_iv_open(&transport->iv, config->device_path, config->managed)) {
+        error = errno ? errno : EPROTO;
+        goto destroy_cond;
+    }
+    const char *enable_async = getenv("VENUS_ASYNC_GPU_WAIT");
+    transport->async_wait =
+        transport->iv.aperture->gpu_wait_capability == RV_GPU_WAIT_CAPABILITY &&
+        (config->managed || !enable_async || strcmp(enable_async, "0"));
+    if (transport->async_wait) {
+        error = start_doorbell_thread(transport);
+        if (error) {
+            rv_iv_close(&transport->iv);
+            goto destroy_cond;
+        }
+    }
+    *out = transport;
+    return 0;
+
+destroy_cond:
+    while (initialized_waits)
+        pthread_cond_destroy(&transport->waits[--initialized_waits].cond);
+    pthread_mutex_destroy(&transport->call_lock);
+destroy_lock:
+    pthread_mutex_destroy(&transport->lock);
+free_transport:
+    free(transport);
+    errno = error;
+    return -1;
+}
+
+void rv_transport_close(struct rv_transport *transport)
+{
+    if (!transport)
+        return;
+    if (transport->async_wait) {
+        close(transport->stop_pipe[1]);
+        pthread_join(transport->doorbell_thread, NULL);
+        close(transport->stop_pipe[0]);
+    }
+    rv_iv_close(&transport->iv);
+    for (unsigned i = 0; i < RV_WAIT_QUEUE_COUNT; ++i)
+        pthread_cond_destroy(&transport->waits[i].cond);
+    pthread_mutex_destroy(&transport->call_lock);
+    pthread_mutex_destroy(&transport->lock);
+    free(transport);
+}
+
+static uint64_t deadline_after(const struct rv_transport *transport);
+static int wait_for_change(struct rv_transport *transport, unsigned index,
+                           uint64_t deadline);
+
+static int reserve_request(struct rv_transport *transport)
+{
+    if (transport->async_wait) {
+        const uint64_t deadline = deadline_after(transport);
+        for (;;) {
+            if (collect_streams(transport))
+                return -1;
+            if (transport->posted - transport->retired < RV_RING_SIZE)
+                break;
+            const int error = wait_for_change(transport, RV_WAIT_RING_SPACE, deadline);
+            if (error)
+                return transport_error(transport, error);
+        }
+    }
+    const int error = current_error(transport);
+    if (error || transport->posted == UINT64_MAX ||
+        transport->posted - transport->retired == RV_RING_SIZE) {
+        errno = error ? error : transport->posted == UINT64_MAX ? EOVERFLOW : EAGAIN;
+        return -1;
+    }
+    return 0;
+}
+
+static void publish_request(struct rv_transport *transport, const struct rv_request *request,
+                            const void *command, bool deferred, struct rv_ticket *ticket)
+{
+    const uint64_t sequence = ++transport->posted;
+    const size_t index = rv_slot(sequence);
+    struct rv_aperture *aperture = transport->iv.aperture;
+    struct rv_submission *submission = &aperture->requests[index];
+    submission->request = *request;
+    if (request->command_bytes)
+        memcpy(submission->command, command, request->command_bytes);
+    transport->consumed[index] = false;
+    transport->deferred[index] = deferred;
+    __atomic_store_n(&aperture->submitted, sequence, __ATOMIC_RELEASE);
+    ticket->sequence = sequence;
+}
+
+int rv_transport_post(struct rv_transport *transport, const struct rv_request *request,
+                      const void *command, struct rv_ticket *ticket)
+{
+    if (!transport || !request || !ticket ||
+        request->command_bytes > RV_COMMAND_LIMIT || request->reply_bytes > RV_REPLY_LIMIT ||
+        (request->command_bytes && !command)) {
+        errno = EINVAL;
+        return -1;
+    }
+    pthread_mutex_lock(&transport->lock);
+    const int result = reserve_request(transport);
+    if (!result)
+        publish_request(transport, request, command, false, ticket);
+    pthread_mutex_unlock(&transport->lock);
+    return result;
+}
+
+int rv_transport_submit_stream(struct rv_transport *transport, uint32_t context,
+                               struct rv_stream_desc stream, void *lease_map,
+                               const void *command, size_t length,
+                               struct rv_ticket *ticket)
+{
+    RV_PM_SCOPE(pm);
+    int gate_error = rv_pm_enter(&pm, RV_PM_INFINITE);
+    if (gate_error) {
+        errno = gate_error;
+        return -1;
+    }
+    if (!transport->async_wait || !lease_map || !command || !ticket ||
+        !length || length > RV_PIPELINE_STREAM_BYTES || (length & 3)) {
+        errno = EINVAL;
+        return -1;
+    }
+    const struct rv_request request = {
+        .operation = RV_STREAM,
+        .context_id = context,
+        .command_bytes = sizeof(stream),
+        .reply_bytes = sizeof(struct rv_ctl_reply),
+    };
+    pthread_mutex_lock(&transport->lock);
+    int result = reserve_request(transport);
+    if (!result) {
+        stream.offset = rv_slot(transport->posted + 1) * RV_PIPELINE_STREAM_BYTES;
+        stream.length = length;
+        memcpy((unsigned char *)lease_map + stream.offset, command, length);
+        publish_request(transport, &request, &stream, true, ticket);
+        const uint64_t completed =
+            __atomic_load_n(&transport->iv.aperture->completed, __ATOMIC_ACQUIRE);
+        if (stream.ring_idx || completed >= transport->kicked_through)
+            result = kick_locked(transport);
+    }
+    pthread_mutex_unlock(&transport->lock);
+    return result;
+}
+
+int rv_transport_flush(struct rv_transport *transport)
+{
+    if (!transport) {
+        errno = EINVAL;
+        return -1;
+    }
+    pthread_mutex_lock(&transport->lock);
+    int result = 0;
+    const int error = current_error(transport);
+    if (error) {
+        errno = error;
+        result = -1;
+    } else if (!transport->async_wait || transport->posted > transport->kicked_through) {
+        result = kick_locked(transport);
+    }
+    pthread_mutex_unlock(&transport->lock);
+    return result;
+}
+
+static const uint64_t ns_per_ms = UINT64_C(1000000);
+
+static int wait_for_change(struct rv_transport *transport, unsigned index,
+                           uint64_t deadline)
+{
+    struct rv_wait_queue *queue = &transport->waits[index];
+    struct timespec interval;
+    if (deadline) {
+        const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        if (now >= deadline)
+            return ETIMEDOUT;
+        const uint64_t remaining = deadline - now;
+        interval = (struct timespec) {
+            .tv_sec = remaining / UINT64_C(1000000000),
+            .tv_nsec = remaining % UINT64_C(1000000000),
+        };
+    }
+    ++queue->sleepers;
+    const uint32_t gpu_bit = index >= RV_WAIT_GPU_FIRST
+        ? UINT32_C(1) << (index - RV_WAIT_GPU_FIRST) : 0;
+    transport->gpu_sleepers |= gpu_bit;
+    const int error = deadline
+        ? pthread_cond_timedwait_relative_np(&queue->cond, &transport->lock, &interval)
+        : pthread_cond_wait(&queue->cond, &transport->lock);
+    --queue->sleepers;
+    transport->gpu_sleepers &= ~gpu_bit;
+    return error;
+}
+
+static uint64_t deadline_after(const struct rv_transport *transport)
+{
+    return clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + transport->timeout_ms * ns_per_ms;
+}
+
+static int wait_for_completion(struct rv_transport *transport, uint64_t sequence)
+{
+    const uint64_t deadline = deadline_after(transport);
+    struct rv_aperture *aperture = transport->iv.aperture;
+    for (;;) {
+        const int error = current_error(transport);
+        if (error) {
+            errno = error;
+            return -1;
+        }
+        const uint64_t completed = __atomic_load_n(&aperture->completed, __ATOMIC_ACQUIRE);
+        if (__atomic_load_n(&aperture->ready, __ATOMIC_ACQUIRE) != RV_MAGIC ||
+            __atomic_load_n(&aperture->accepted_epoch, __ATOMIC_ACQUIRE) != transport->iv.epoch ||
+            completed > transport->posted || completed < transport->retired)
+            return transport_error(transport, EPROTO);
+        if (completed >= sequence)
+            return 0;
+        if (transport->async_wait) {
+            const int error = wait_for_change(transport, RV_WAIT_REQUEST_FIRST + rv_slot(sequence),
+                                              deadline);
+            if (error)
+                return transport_error(transport, error);
+            continue;
+        }
+        const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        if (now >= deadline)
+            return transport_error(transport, ETIMEDOUT);
+        const uint32_t remaining_ms = (uint32_t)((deadline - now + ns_per_ms - 1) / ns_per_ms);
+        if (!rv_iv_wait_timeout(&transport->iv, remaining_ms))
+            return transport_error(transport, errno ? errno : EIO);
+    }
+}
+
+int rv_transport_wait_stream(struct rv_transport *transport, struct rv_ticket ticket)
+{
+    pthread_mutex_lock(&transport->lock);
+    int result = collect_streams(transport);
+    if (!result && ticket.sequence > transport->retired) {
+        if (ticket.sequence > transport->kicked_through)
+            result = kick_locked(transport);
+        if (!result)
+            result = wait_for_completion(transport, ticket.sequence);
+        if (!result)
+            result = collect_streams(transport);
+    }
+    pthread_mutex_unlock(&transport->lock);
+    return result;
+}
+
+int rv_transport_wait(struct rv_transport *transport, struct rv_ticket ticket,
+                      void *reply, size_t capacity, size_t *actual)
+{
+    if (!transport || !ticket.sequence) {
+        errno = EINVAL;
+        return -1;
+    }
+    pthread_mutex_lock(&transport->lock);
+    int result = -1;
+    const uint64_t sequence = ticket.sequence;
+    const size_t slot = rv_slot(sequence);
+    const int error = current_error(transport);
+    if (error) {
+        errno = error;
+        goto done;
+    }
+    if (sequence <= transport->retired || sequence > transport->posted || transport->consumed[slot]) {
+        errno = ESTALE;
+        goto done;
+    }
+    if (wait_for_completion(transport, sequence) ||
+        (transport->async_wait && collect_streams(transport)))
+        goto done;
+
+    const struct rv_aperture *aperture = transport->iv.aperture;
+    const struct rv_completion *completion = &aperture->replies[slot];
+    const uint32_t expected = aperture->requests[slot].request.reply_bytes;
+    if (completion->bytes != (completion->status ? 0 : expected)) {
+        transport_error(transport, EPROTO);
+        goto done;
+    }
+    if (completion->bytes > capacity || (completion->bytes && !reply)) {
+        errno = ENOBUFS;
+        goto done;
+    }
+    if (actual)
+        *actual = completion->bytes;
+    if (completion->bytes)
+        memcpy(reply, completion->reply, completion->bytes);
+    transport->consumed[slot] = true;
+    retire_consumed(transport);
+    if (completion->status) {
+        errno = completion->status > 0 ? completion->status : EIO;
+        goto done;
+    }
+    result = 0;
+done:
+    pthread_mutex_unlock(&transport->lock);
+    return result;
+}
+
+int rv_transport_call(struct rv_transport *transport, const struct rv_request *request,
+                      const void *command, void *reply, size_t capacity, size_t *actual)
+{
+    RV_PM_SCOPE(pm);
+    int gate_error = rv_pm_enter(&pm, RV_PM_INFINITE);
+    if (gate_error) {
+        errno = gate_error;
+        return -1;
+    }
+    if (!transport || !request || request->reply_bytes > capacity ||
+        (request->reply_bytes && !reply)) {
+        errno = EINVAL;
+        return -1;
+    }
+    pthread_mutex_lock(&transport->call_lock);
+    struct rv_ticket ticket;
+    int result = rv_transport_post(transport, request, command, &ticket);
+    if (!result)
+        result = rv_transport_flush(transport);
+    if (!result)
+        result = rv_transport_wait(transport, ticket, reply, capacity, actual);
+    pthread_mutex_unlock(&transport->call_lock);
+    return result;
+}
+
+bool rv_transport_has_async_wait(const struct rv_transport *transport)
+{
+    return transport->async_wait;
+}
+
+int rv_transport_wait_gpu(struct rv_transport *transport, uint32_t context,
+                          const struct rv_gpu_wait *wait, int32_t *status)
+{
+    const uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    RV_PM_SCOPE(pm);
+    const uint64_t timeout_ns = wait->timeout_ms == UINT32_MAX
+        ? RV_PM_INFINITE : wait->timeout_ms * ns_per_ms;
+    int gate_error = rv_pm_enter(&pm, timeout_ns);
+    if (gate_error == ETIMEDOUT) {
+        *status = RV_CTL_TIMEOUT;
+        return 0;
+    }
+    if (gate_error) {
+        errno = gate_error;
+        return -1;
+    }
+    const uint64_t deadline = wait->timeout_ms == UINT32_MAX ? 0 :
+        start + wait->timeout_ms * ns_per_ms;
+    const uint64_t watchdog = deadline ? deadline + transport->timeout_ms * ns_per_ms : 0;
+    struct rv_aperture *aperture = transport->iv.aperture;
+    unsigned slot_index;
+    int result = -1;
+    pthread_mutex_lock(&transport->lock);
+    for (;;) {
+        if (!rv_transport_is_live(transport)) {
+            transport_error(transport, ENODEV);
+            goto done;
+        }
+        for (slot_index = 0; slot_index < RV_GPU_WAIT_SLOTS; ++slot_index)
+            if (!transport->gpu_wait_busy[slot_index])
+                break;
+        if (slot_index < RV_GPU_WAIT_SLOTS)
+            break;
+        const int error = wait_for_change(transport, RV_WAIT_GPU_SPACE, deadline);
+        if (error == ETIMEDOUT) {
+            *status = RV_CTL_TIMEOUT;
+            result = 0;
+            goto done;
+        }
+        if (error) {
+            transport_error(transport, error);
+            goto done;
+        }
+    }
+
+    struct rv_gpu_wait request = *wait;
+    if (deadline) {
+        const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        request.timeout_ms = now < deadline ? (deadline - now + ns_per_ms - 1) / ns_per_ms : 0;
+    }
+    struct rv_gpu_wait_slot *slot = &aperture->gpu_waits[slot_index];
+    const uint64_t sequence = __atomic_load_n(&slot->requested, __ATOMIC_RELAXED) + 1;
+    if (!sequence) {
+        transport_error(transport, EOVERFLOW);
+        goto done;
+    }
+    transport->gpu_wait_busy[slot_index] = true;
+    slot->context = context;
+    memcpy(slot->command, &request, sizeof(request));
+    __atomic_store_n(&slot->requested, sequence, __ATOMIC_RELEASE);
+    if (!kick_locked(transport)) {
+        while (rv_transport_is_live(transport)) {
+            if (__atomic_load_n(&slot->completed, __ATOMIC_ACQUIRE) == sequence) {
+                if (collect_streams(transport))
+                    break;
+                *status = slot->status;
+                result = 0;
+                break;
+            }
+            const int error = wait_for_change(transport, RV_WAIT_GPU_FIRST + slot_index,
+                                              watchdog);
+            if (error) {
+                transport_error(transport, error);
+                break;
+            }
+        }
+        if (result && !current_error(transport))
+            transport_error(transport, ENODEV);
+    }
+    transport->gpu_wait_busy[slot_index] = false;
+    notify_waiters(transport, RV_WAIT_GPU_SPACE);
+done:
+    if (result)
+        errno = current_error(transport);
+    pthread_mutex_unlock(&transport->lock);
+    return result;
+}
+
+const char *rv_transport_error(const struct rv_transport *transport)
+{
+    const int error = transport ? current_error(transport) : 0;
+    return strerror(error ? error : errno);
+}
+
+void *rv_transport_aperture(struct rv_transport *transport)
+{
+    return transport ? transport->iv.aperture : NULL;
+}
+
+size_t rv_transport_aperture_size(const struct rv_transport *transport)
+{
+    return transport ? transport->iv.aperture_size : 0;
+}
