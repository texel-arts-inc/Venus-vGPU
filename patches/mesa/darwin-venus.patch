+#ifndef VENUS_IVSHMEM_H
+#define VENUS_IVSHMEM_H
+
+#include "wire.h"
+#include <stdbool.h>
+#include <pthread.h>
+
+struct rv_ivshmem {
+    struct rv_aperture *aperture;
+    size_t aperture_size;
+    int connection;
+    int lock;
+    int incoming;
+    int outgoing;
+    uint32_t peer;
+    uint32_t guest;
+    uint64_t epoch;
+};
+
+bool rv_iv_open(struct rv_ivshmem *iv, const char *path, bool managed);
+void rv_iv_close(struct rv_ivshmem *iv);
+bool rv_iv_ring(struct rv_ivshmem *iv);
+bool rv_iv_wait_interruptible(struct rv_ivshmem *iv, int stop_fd, pthread_mutex_t *lock);
+bool rv_iv_wait(struct rv_ivshmem *iv);
+bool rv_iv_wait_timeout(struct rv_ivshmem *iv, uint32_t timeout_ms);
+
+#endif
--- /dev/null
+++ b/src/virtio/vulkan/reverse_venus/rv_client.c
@@ -0,0 +1,798 @@
+#include "rv_client.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static pthread_mutex_t rv_shared_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t rv_command_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct rv_client_session *rv_shared_session;
+
+_Static_assert(sizeof(struct rv_ctl_request) == 48, "RV control request ABI");
+_Static_assert(sizeof(struct rv_ctl_reply) == 200, "RV control reply ABI");
+_Static_assert(sizeof(struct rv_stream_desc) == 176, "RV stream descriptor ABI");
+_Static_assert(sizeof(struct rv_gpu_wait) == 144, "RV GPU wait ABI");
+_Static_assert(sizeof(struct virgl_renderer_capset_venus) == 160,
+                "Venus capset ABI");
+
+int
+rv_client_control(struct rv_client *client,
+                  const struct rv_ctl_request *request,
+                  struct rv_ctl_reply *reply)
+{
+   if (!client || !client->session || !client->session->transport || !request || !reply) {
+      errno = EINVAL;
+      return -1;
+   }
+
+   const struct rv_request wire = {
+      .operation = RV_CONTROL,
+      .context_id = client->context_id,
+      .command_bytes = sizeof(*request),
+      .reply_bytes = sizeof(*reply),
+   };
+   size_t actual = 0;
+   if (rv_transport_call(client->session->transport, &wire, request, reply,
+                         sizeof(*reply), &actual))
+      return -1;
+   if (actual != sizeof(*reply)) {
+      errno = EPROTO;
+      return -1;
+   }
+   return 0;
+}
+
+static int
+rv_client_session_create(struct rv_client_session *session, const char *device_path,
+                         uint32_t timeout_ms, bool managed)
+{
+   session->managed = managed;
+   session->vram_fd = -1;
+   if (pthread_mutex_init(&session->allocator_mutex, NULL)) {
+      errno = ENOMEM;
+      return -1;
+   }
+   const struct rv_transport_config config = {
+      .device_path = device_path,
+      .timeout_ms = timeout_ms,
+      .managed = managed,
+   };
+   if (rv_transport_open(&config, &session->transport))
+      goto fail_mutex;
+
+   struct rv_client bootstrap = { .session = session, .context_id = 0 };
+   struct rv_ctl_request request = { .opcode = RV_CTL_GET_SESSION };
+   struct rv_ctl_reply reply;
+   if (rv_client_control(&bootstrap, &request, &reply) ||
+       reply.status != RV_CTL_OK || !reply.generation) {
+      errno = EPROTO;
+      goto fail_transport;
+   }
+   session->generation = reply.generation;
+   session->next_lease_offset =
+      (sizeof(struct rv_aperture) + 4095u) & ~((uint64_t)4095u);
+   session->next_resource_id = 0x80000000u;
+   session->next_vram_id = 0x40000000u;
+
+   request = (struct rv_ctl_request){ .opcode = RV_CTL_QUERY_CAPS };
+   if (rv_client_control(&bootstrap, &request, &reply) ||
+       reply.status != RV_CTL_OK || reply.cap_count != RV_CTL_CAP_WORDS) {
+      errno = EPROTO;
+      goto fail_transport;
+   }
+   memcpy(&session->capset, reply.caps, sizeof(session->capset));
+   if (!session->capset.wire_format_version || !session->capset.vk_xml_version ||
+       !session->capset.vk_ext_command_serialization_spec_version ||
+       !session->capset.vk_mesa_venus_protocol_spec_version) {
+      errno = EPROTO;
+      goto fail_transport;
+   }
+   return 0;
+
+fail_transport: {
+   const int error = errno;
+   rv_transport_close(session->transport);
+   session->transport = NULL;
+   pthread_mutex_destroy(&session->allocator_mutex);
+   errno = error;
+   return -1;
+}
+fail_mutex: {
+   const int error = errno;
+   pthread_mutex_destroy(&session->allocator_mutex);
+   errno = error;
+   return -1;
+}
+}
+
+static int
+rv_client_context_command(struct rv_client_session *session, uint32_t context_id,
+                          uint32_t operation)
+{
+   const struct rv_request request = {
+      .operation = operation,
+      .context_id = context_id,
+   };
+   size_t actual = 0;
+   int result = rv_transport_call(session->transport, &request, NULL, NULL, 0, &actual);
+   if (!result && actual) {
+      errno = EPROTO;
+      return -1;
+   }
+   return result;
+}
+
+int
+rv_client_open_paths(struct rv_client *client, const char *device_path,
+                     const char *pool_path, uint32_t timeout_ms,
+                     bool follow_runtime, bool managed)
+{
+   if (!client || !device_path) {
+      errno = EINVAL;
+      return -1;
+   }
+   memset(client, 0, sizeof(*client));
+   client->vram_fd = -1;
+   pthread_mutex_lock(&rv_shared_mutex);
+   struct rv_client_session *session = rv_shared_session;
+   struct rv_client_session *previous = NULL;
+   bool created = false;
+   if (session && !rv_transport_is_live(session->transport)) {
+      rv_transport_mark_lost(session->transport);
+      rv_shared_session = NULL;
+      session = NULL;
+   } else if (session && follow_runtime && strcmp(session->socket_path, device_path)) {
+      previous = session;
+      session = NULL;
+   }
+   if (session) {
+      if (session->managed != managed || strcmp(session->socket_path, device_path) ||
+          strcmp(session->pool_path, pool_path)) {
+         pthread_mutex_unlock(&rv_shared_mutex);
+         errno = EBUSY;
+         return -1;
+      }
+   } else {
+      session = calloc(1, sizeof(*session));
+      if (!session) {
+         pthread_mutex_unlock(&rv_shared_mutex);
+         return -1;
+      }
+      session->socket_path = strdup(device_path);
+      session->pool_path = strdup(pool_path);
+      if (!session->socket_path || !session->pool_path ||
+          rv_client_session_create(session, device_path, timeout_ms, managed)) {
+         const int error = errno ? errno : ENOMEM;
+         free(session->socket_path);
+         free(session->pool_path);
+         free(session);
+         pthread_mutex_unlock(&rv_shared_mutex);
+         errno = error;
+         return -1;
+      }
+      if (previous)
+         rv_transport_mark_lost(previous->transport);
+      rv_shared_session = session;
+      created = true;
+   }
+
+   uint32_t context_id;
+   for (context_id = 0; context_id < RV_CONTEXT_COUNT; context_id++) {
+      if (!(session->context_mask & (1u << context_id)))
+         break;
+   }
+   if (context_id == RV_CONTEXT_COUNT) {
+      pthread_mutex_unlock(&rv_shared_mutex);
+      errno = EMFILE;
+      return -1;
+   }
+   if (!(created && context_id == 0) &&
+       rv_client_context_command(session, context_id, RV_CONTEXT_OPEN)) {
+      const int error = errno;
+      pthread_mutex_unlock(&rv_shared_mutex);
+      errno = error;
+      return -1;
+   }
+
+   session->context_mask |= (uint16_t)(1u << context_id);
+   session->context_refs++;
+   client->session = session;
+   client->context_id = context_id;
+   client->generation = session->generation;
+   client->vram_fd = session->vram_fd;
+   client->vram_size = session->vram_size;
+   client->vram_alignment = session->vram_alignment;
+   client->has_guest_vram = session->has_guest_vram;
+   client->capset = session->capset;
+   if (created) {
+      const char *path = pool_path;
+      if (path[0])
+         (void)rv_client_query_vram(client, path);
+      client->vram_fd = session->vram_fd;
+      client->vram_size = session->vram_size;
+      client->vram_alignment = session->vram_alignment;
+      client->has_guest_vram = session->has_guest_vram;
+   }
+   pthread_mutex_unlock(&rv_shared_mutex);
+   return 0;
+}
+
+int
+rv_client_open(struct rv_client *client, const char *device_path,
+               uint32_t timeout_ms)
+{
+   const char *pool_path = getenv("VENUS_GPU_POOL");
+   return rv_client_open_paths(client, device_path, pool_path ? pool_path : "",
+                               timeout_ms, false, false);
+}
+
+int
+rv_client_open_runtime(struct rv_client *client, const char *state_file,
+                       uint32_t timeout_ms)
+{
+   char directory[PATH_MAX];
+   FILE *file = fopen(state_file, "r");
+   if (!file)
+      return -1;
+   const bool read = fgets(directory, sizeof(directory), file) != NULL;
+   fclose(file);
+   if (!read || directory[0] != '/' || !strchr(directory, '\n')) {
+      errno = EINVAL;
+      return -1;
+   }
+   *strchr(directory, '\n') = '\0';
+
+   char socket_path[PATH_MAX], pool_path[PATH_MAX];
+   if (snprintf(socket_path, sizeof(socket_path), "%s/doorbell.sock", directory) >=
+          (int)sizeof(socket_path) ||
+       snprintf(pool_path, sizeof(pool_path), "%s/pool.ram", directory) >=
+          (int)sizeof(pool_path)) {
+      errno = ENAMETOOLONG;
+      return -1;
+   }
+   return rv_client_open_paths(client, socket_path, pool_path, timeout_ms, true, false);
+}
+
+void
+rv_client_close(struct rv_client *client)
+{
+   if (!client || !client->session)
+      return;
+   pthread_mutex_lock(&rv_shared_mutex);
+   struct rv_client_session *session = client->session;
+   const int saved_errno = errno;
+   pthread_mutex_lock(&rv_command_mutex);
+   if (client->command_map)
+      (void)rv_client_release_lease(client, &client->command_lease);
+   if (client->pipeline_map)
+      (void)rv_client_release_lease(client, &client->pipeline_lease);
+   pthread_mutex_unlock(&rv_command_mutex);
+   (void)rv_client_context_command(session, client->context_id, RV_CONTEXT_CLOSE);
+   session->context_mask &= (uint16_t)~(1u << client->context_id);
+   if (session->context_refs)
+      session->context_refs--;
+   if (!session->context_refs) {
+      if (rv_shared_session == session)
+         rv_shared_session = NULL;
+      if (session->vram_fd >= 0)
+         close(session->vram_fd);
+      rv_transport_close(session->transport);
+      pthread_mutex_destroy(&session->allocator_mutex);
+      free(session->socket_path);
+      free(session->pool_path);
+      free(session);
+   }
+   memset(client, 0, sizeof(*client));
+   client->vram_fd = -1;
+   pthread_mutex_unlock(&rv_shared_mutex);
+   errno = saved_errno;
+}
+
+int
+rv_client_query_vram(struct rv_client *client, const char *path)
+{
+   if (!client || !client->session || !path || !path[0]) {
+      errno = EINVAL;
+      return -1;
+   }
+   int fd = open(path, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+   if (fd < 0)
+      return -1;
+   struct stat st;
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 16384 ||
+       st.st_uid != geteuid() || (st.st_mode & 0777) != 0600) {
+      const int saved = errno ? errno : EPERM;
+      close(fd);
+      errno = saved;
+      return -1;
+   }
+   struct rv_ctl_request request = { .opcode = RV_CTL_QUERY_VRAM };
+   request.u.lease.generation = client->generation;
+   request.u.lease.offset = 16384;
+   struct rv_ctl_reply reply;
+   unsigned char pool_id[16];
+   const ssize_t id_bytes = pread(fd, pool_id, sizeof(pool_id), 0);
+   if (id_bytes != (ssize_t)sizeof(pool_id)) {
+      const int saved = errno ? errno : EIO;
+      close(fd);
+      errno = saved;
+      return -1;
+   }
+   if (rv_client_control(client, &request, &reply)) {
+      const int saved = errno;
+      close(fd);
+      errno = saved;
+      return -1;
+   }
+   if (reply.status != RV_CTL_OK || reply.generation != client->generation ||
+       reply.cap_count != 4 || memcmp(pool_id, reply.caps, sizeof(pool_id)) ||
+       !reply.ticket || (reply.ticket & (reply.ticket - 1)) ||
+       reply.resource_size != (uint64_t)st.st_size) {
+      const int saved = reply.status == RV_CTL_OUT_OF_SPACE ? ENOSPC : EPROTO;
+      close(fd);
+      errno = saved;
+      return -1;
+   }
+   client->session->vram_fd = fd;
+   client->session->vram_size = reply.resource_size;
+   client->session->vram_alignment = reply.ticket > 16384 ? reply.ticket : 16384;
+   client->session->has_guest_vram = true;
+   return 0;
+}
+
+int
+rv_client_alloc_vram(struct rv_client *client, uint64_t size,
+                     struct rv_lease_desc *lease)
+{
+   if (!client || !client->session || !client->session->has_guest_vram || !size || !lease ||
+       size > UINT64_MAX - (client->session->vram_alignment - 1)) {
+      errno = EINVAL;
+      return -1;
+   }
+   pthread_mutex_lock(&client->session->allocator_mutex);
+   const uint64_t aligned = (size + client->session->vram_alignment - 1) &
+                            ~(client->session->vram_alignment - 1);
+   if (client->session->next_vram_id < 0x40000000u ||
+       client->session->next_vram_id >= 0x80000000u || aligned > client->session->vram_size) {
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      errno = ENOSPC;
+      return -1;
+   }
+   const uint32_t id = client->session->next_vram_id;
+   client->session->next_vram_id = id == 0x7fffffffu ? 0 : id + 1;
+   struct rv_ctl_request request = { .opcode = RV_CTL_ALLOC_VRAM };
+   request.u.lease = (struct rv_lease_desc){
+      .generation = client->generation,
+      .resource_id = id,
+      .offset = client->session->vram_alignment,
+      .length = aligned,
+      .resource_class = RV_LEASE_APPLICATION,
+   };
+   struct rv_ctl_reply reply;
+   const int call_result = rv_client_control(client, &request, &reply);
+   if (call_result || reply.status != RV_CTL_OK ||
+       reply.generation != client->generation || reply.resource_id != id ||
+       reply.resource_size != aligned ||
+       reply.resource_size > client->session->vram_size ||
+       reply.ticket < 16384 ||
+       reply.ticket > client->session->vram_size - reply.resource_size ||
+       (reply.ticket & (client->session->vram_alignment - 1)) ||
+       (reply.resource_size & (client->session->vram_alignment - 1))) {
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      errno = call_result ? errno : (reply.status == RV_CTL_OUT_OF_SPACE ?
+                                     ENOSPC : EPROTO);
+      return -1;
+   }
+   *lease = (struct rv_lease_desc){
+      .generation = client->generation,
+      .resource_id = id,
+      .offset = reply.ticket,
+      .length = reply.resource_size,
+      .resource_class = RV_LEASE_APPLICATION,
+   };
+   pthread_mutex_unlock(&client->session->allocator_mutex);
+   return 0;
+}
+
+int
+rv_client_release_vram(struct rv_client *client,
+                       const struct rv_lease_desc *lease)
+{
+   if (!client || !lease || !client->session->has_guest_vram ||
+       lease->generation != client->generation ||
+       lease->resource_id < 0x40000000u ||
+       lease->resource_id >= 0x80000000u) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct rv_ctl_request request = { .opcode = RV_CTL_RELEASE_VRAM };
+   request.u.lease = *lease;
+   struct rv_ctl_reply reply;
+   if (rv_client_control(client, &request, &reply))
+      return -1;
+   if (reply.status != RV_CTL_OK) {
+      errno = reply.status == RV_CTL_NOT_FOUND ? ENOENT : EIO;
+      return -1;
+   }
+   return 0;
+}
+
+int
+rv_client_register_lease(struct rv_client *client,
+                         const struct rv_lease_desc *lease,
+                         uint32_t *resource_id, uint64_t *resource_size)
+{
+   if (!client || !client->session || !lease || !resource_id || !resource_size ||
+       lease->generation != client->generation || !lease->length ||
+       lease->resource_id > UINT32_MAX) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct rv_ctl_request request = { .opcode = RV_CTL_REGISTER_LEASE };
+   request.u.lease = *lease;
+   struct rv_ctl_reply reply;
+   if (rv_client_control(client, &request, &reply))
+      return -1;
+   if (reply.status != RV_CTL_OK || !reply.resource_id ||
+       reply.resource_id > UINT32_MAX || reply.resource_size < lease->length) {
+      errno = reply.status == RV_CTL_OUT_OF_SPACE ? ENOSPC : EIO;
+      return -1;
+   }
+   *resource_id = (uint32_t)reply.resource_id;
+   *resource_size = reply.resource_size;
+   return 0;
+}
+
+int
+rv_client_release_lease(struct rv_client *client,
+                        const struct rv_lease_desc *lease)
+{
+   if (!client || !client->session || !lease || lease->generation != client->generation) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct rv_ctl_request request = { .opcode = RV_CTL_RELEASE_LEASE };
+   request.u.lease = *lease;
+   struct rv_ctl_reply reply;
+   if (rv_client_control(client, &request, &reply))
+      return -1;
+   if (reply.status != RV_CTL_OK) {
+      errno = reply.status == RV_CTL_NOT_FOUND ? ENOENT : EIO;
+      return -1;
+   }
+   pthread_mutex_lock(&client->session->allocator_mutex);
+   if (client->session->free_extent_count < RV_CTL_MAX_LEASES) {
+      uint32_t i = client->session->free_extent_count++;
+      client->session->free_extents[i].offset = lease->offset;
+      client->session->free_extents[i].length = lease->length;
+      for (i = client->session->free_extent_count - 1; i > 0; i--) {
+         if (client->session->free_extents[i - 1].offset <=
+             client->session->free_extents[i].offset)
+            break;
+         const struct rv_client_extent tmp = client->session->free_extents[i - 1];
+         client->session->free_extents[i - 1] = client->session->free_extents[i];
+         client->session->free_extents[i] = tmp;
+      }
+      for (i = 0; i + 1 < client->session->free_extent_count;) {
+         const uint64_t end = client->session->free_extents[i].offset +
+                              client->session->free_extents[i].length;
+         if (end >= client->session->free_extents[i + 1].offset) {
+            const uint64_t next_end = client->session->free_extents[i + 1].offset +
+                                      client->session->free_extents[i + 1].length;
+            if (next_end > end)
+               client->session->free_extents[i].length =
+                  next_end - client->session->free_extents[i].offset;
+            memmove(&client->session->free_extents[i + 1],
+                    &client->session->free_extents[i + 2],
+                    (client->session->free_extent_count - i - 2) *
+                       sizeof(client->session->free_extents[0]));
+            client->session->free_extent_count--;
+         } else {
+            i++;
+         }
+      }
+   }
+   pthread_mutex_unlock(&client->session->allocator_mutex);
+   return 0;
+}
+
+int
+rv_client_alloc_lease(struct rv_client *client, uint64_t size,
+                      uint32_t resource_class,
+                      struct rv_lease_desc *lease, void **map)
+{
+   if (!client || !client->session || !client->session->transport || !size || !lease || !map ||
+       resource_class < RV_LEASE_REPLY ||
+       resource_class > RV_LEASE_APPLICATION) {
+      errno = EINVAL;
+      return -1;
+   }
+   pthread_mutex_lock(&client->session->allocator_mutex);
+   long page_size = sysconf(_SC_PAGESIZE);
+   if (page_size <= 0 || (page_size & (page_size - 1))) {
+      errno = EINVAL;
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      return -1;
+   }
+   const uint64_t alignment = (uint64_t)page_size > 4096 ?
+      (uint64_t)page_size : 4096;
+   if (size > UINT64_MAX - (alignment - 1)) {
+      errno = EOVERFLOW;
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      return -1;
+   }
+   const uint64_t length = (size + alignment - 1) & ~(alignment - 1);
+   uint64_t offset =
+      (client->session->next_lease_offset + alignment - 1) & ~(alignment - 1);
+   int from_free = 0;
+   for (uint32_t i = 0; i < client->session->free_extent_count; i++) {
+      if (client->session->free_extents[i].length < length)
+         continue;
+      offset = client->session->free_extents[i].offset;
+      from_free = 1;
+      if (client->session->free_extents[i].length == length) {
+         memmove(&client->session->free_extents[i], &client->session->free_extents[i + 1],
+                 (client->session->free_extent_count - i - 1) *
+                    sizeof(client->session->free_extents[0]));
+         client->session->free_extent_count--;
+      } else {
+         client->session->free_extents[i].offset += length;
+         client->session->free_extents[i].length -= length;
+      }
+      break;
+   }
+   if (offset > rv_transport_aperture_size(client->session->transport) ||
+       length > rv_transport_aperture_size(client->session->transport) - offset ||
+       !client->session->next_resource_id) {
+      errno = ENOSPC;
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      return -1;
+   }
+
+   struct rv_lease_desc desc = {
+      .generation = client->generation,
+      .resource_id = client->session->next_resource_id,
+      .offset = offset,
+      .length = length,
+      .resource_class = resource_class,
+   };
+   uint32_t res_id = 0;
+   uint64_t resource_size = 0;
+   if (rv_client_register_lease(client, &desc, &res_id, &resource_size)) {
+      if (from_free && client->session->free_extent_count < RV_CTL_MAX_LEASES) {
+         client->session->free_extents[client->session->free_extent_count++] =
+            (struct rv_client_extent){ offset, length };
+      }
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      return -1;
+   }
+   if (res_id != desc.resource_id || resource_size < length) {
+      const int error = EPROTO;
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      (void)rv_client_release_lease(client, &desc);
+      errno = error;
+      return -1;
+   }
+
+   void *aperture = rv_transport_aperture(client->session->transport);
+   if (!aperture) {
+      const int error = EFAULT;
+      pthread_mutex_unlock(&client->session->allocator_mutex);
+      (void)rv_client_release_lease(client, &desc);
+      errno = error;
+      return -1;
+   }
+   *lease = desc;
+   *map = (unsigned char *)aperture + offset;
+   if (!from_free)
+      client->session->next_lease_offset = offset + length;
+   if (client->session->next_resource_id == UINT32_MAX)
+      client->session->next_resource_id = 0;
+   else
+      client->session->next_resource_id++;
+   pthread_mutex_unlock(&client->session->allocator_mutex);
+   return 0;
+}
+
+int
+rv_client_sync_lifecycle(struct rv_client *client, uint32_t opcode,
+                         uint32_t sync_id, uint64_t initial_value)
+{
+   if (!client || !client->session || (opcode != RV_CTL_CREATE_SYNC &&
+                   opcode != RV_CTL_DESTROY_SYNC) ||
+       sync_id >= RV_CTL_MAX_SYNCS) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct rv_ctl_request request = { .opcode = opcode };
+   request.u.sync = (struct rv_sync_desc){
+      .generation = client->generation,
+      .sync_id = sync_id,
+      .initial_value = initial_value,
+   };
+   struct rv_ctl_reply reply;
+   if (rv_client_control(client, &request, &reply))
+      return -1;
+   if (reply.status != RV_CTL_OK) {
+      errno = reply.status == RV_CTL_OUT_OF_SPACE ? ENOSPC : EIO;
+      return -1;
+   }
+   return 0;
+}
+
+int
+rv_client_sync_value(struct rv_client *client, uint32_t opcode,
+                     uint32_t sync_id, uint64_t value, uint64_t *out_value)
+{
+   if (!client || !client->session || (opcode != RV_CTL_READ_SYNC &&
+                   opcode != RV_CTL_WRITE_SYNC) ||
+       sync_id >= RV_CTL_MAX_SYNCS) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct rv_ctl_request request = { .opcode = opcode };
+   request.u.sync = (struct rv_sync_desc){
+      .generation = client->generation,
+      .sync_id = sync_id,
+      .initial_value = value,
+   };
+   struct rv_ctl_reply reply;
+   if (rv_client_control(client, &request, &reply))
+      return -1;
+   if (reply.status != RV_CTL_OK) {
+      errno = EIO;
+      return -1;
+   }
+   if (out_value)
+      *out_value = reply.ticket;
+   return 0;
+}
+
+int
+rv_client_submit_stream(struct rv_client *client,
+                        const struct rv_stream_desc *stream,
+                        const void *cs, size_t cs_size,
+                        struct rv_ctl_reply *reply)
+{
+   if (!client || !client->session || !stream || !cs || !cs_size || !reply ||
+       stream->generation != client->generation ||
+       cs_size > UINT64_MAX || (cs_size & 3) ||
+       stream->sync_count > RV_CTL_MAX_WAIT_CONDITIONS) {
+      errno = EINVAL;
+      return -1;
+   }
+   struct rv_lease_desc lease;
+   void *map = NULL;
+   const size_t cache_size = 64 * 1024;
+   /* The stream reply follows CPU decode, so the next submit can reuse the lease. */
+   if (cs_size <= cache_size) {
+      pthread_mutex_lock(&rv_command_mutex);
+      if (!client->command_map && !client->command_cache_unusable)
+         (void)rv_client_alloc_lease(client, cache_size, RV_LEASE_COMMAND,
+                                    &client->command_lease, &client->command_map);
+      if (client->command_map && !client->command_cache_unusable) {
+         lease = client->command_lease;
+         map = client->command_map;
+      } else {
+         pthread_mutex_unlock(&rv_command_mutex);
+      }
+   }
+   const bool reused = map != NULL;
+   if (!reused && rv_client_alloc_lease(client, cs_size, RV_LEASE_COMMAND,
+                             &lease, &map))
+      return -1;
+   memcpy(map, cs, cs_size);
+
+   struct rv_stream_desc desc = *stream;
+   desc.lease_id = lease.resource_id;
+   desc.offset = 0;
+   desc.length = cs_size;
+   const struct rv_request request = {
+      .operation = RV_STREAM,
+      .context_id = client->context_id,
+      .command_bytes = sizeof(desc),
+      .reply_bytes = sizeof(*reply),
+   };
+   size_t actual = 0;
+   const int call_result = rv_transport_call(client->session->transport, &request,
+                                              &desc, reply, sizeof(*reply),
+                                              &actual);
+   const int saved_errno = errno;
+   int release_result = 0;
+   if (reused) {
+      /* A failed transport call might leave the guest reading this lease. */
+      if (call_result)
+         client->command_cache_unusable = true;
+      pthread_mutex_unlock(&rv_command_mutex);
+   } else {
+      release_result = rv_client_release_lease(client, &lease);
+   }
+   if (call_result || actual != sizeof(*reply) || release_result) {
+      errno = call_result ? saved_errno : (release_result ? errno : EPROTO);
+      return -1;
+   }
+   if (reply->status != RV_CTL_OK) {
+      if (reply->status == RV_CTL_DEVICE_LOST)
+         rv_transport_mark_lost(client->session->transport);
+      errno = reply->status == RV_CTL_DEVICE_LOST ? ENODEV : EIO;
+      return -1;
+   }
+   if (!reply->ticket ||
+       (desc.ring_idx && (!reply->resource_id ||
+                          reply->resource_size != desc.ring_idx))) {
+      errno = EPROTO;
+      return -1;
+   }
+   return 0;
+}
+
+int
+rv_client_defer_stream(struct rv_client *client, const struct rv_stream_desc *stream,
+                       const void *cs, size_t cs_size, struct rv_ticket *ticket)
+{
+   struct rv_transport *transport = client->session->transport;
+   if (cs_size > RV_PIPELINE_STREAM_BYTES || !rv_transport_has_async_wait(transport))
+      return 1;
+
+   void *map = __atomic_load_n(&client->pipeline_map, __ATOMIC_ACQUIRE);
+   if (!map) {
+      pthread_mutex_lock(&rv_command_mutex);
+      map = __atomic_load_n(&client->pipeline_map, __ATOMIC_RELAXED);
+      if (!map && rv_client_alloc_lease(client, RV_RING_SIZE * RV_PIPELINE_STREAM_BYTES,
+                                        RV_LEASE_COMMAND, &client->pipeline_lease, &map)) {
+         const int error = errno;
+         pthread_mutex_unlock(&rv_command_mutex);
+         errno = error;
+         return error == ENOSPC || error == ENOMEM ? 1 : -1;
+      }
+      __atomic_store_n(&client->pipeline_map, map, __ATOMIC_RELEASE);
+      pthread_mutex_unlock(&rv_command_mutex);
+   }
+   struct rv_stream_desc desc = *stream;
+   desc.lease_id = client->pipeline_lease.resource_id;
+   struct rv_ticket ignored;
+   return rv_transport_submit_stream(transport, client->context_id, desc, map,
+                                     cs, cs_size, ticket ? ticket : &ignored);
+}
+
+int
+rv_client_wait_gpu(struct rv_client *client, const struct rv_gpu_wait *wait,
+                   int32_t *status)
+{
+   if (!client || !client->session || !wait || !status || !wait->count ||
+       wait->count > RV_CTL_MAX_WAIT_CONDITIONS) {
+      errno = EINVAL;
+      return -1;
+   }
+   if (wait->timeout_ms && rv_transport_has_async_wait(client->session->transport)) {
+      const int result = rv_transport_wait_gpu(client->session->transport,
+                                               client->context_id, wait, status);
+      if (!result && *status == RV_CTL_DEVICE_LOST)
+         rv_transport_mark_lost(client->session->transport);
+      return result;
+   }
+
+   const struct rv_request request = {
+      .operation = RV_WAIT_GPU,
+      .context_id = client->context_id,
+      .command_bytes = sizeof(*wait),
+      .reply_bytes = sizeof(*status),
+   };
+   size_t actual = 0;
+   if (rv_transport_call(client->session->transport, &request, wait, status,
+                         sizeof(*status), &actual))
+      return -1;
+   if (actual != sizeof(*status)) {
+      errno = EPROTO;
+      return -1;
+   }
+   if (*status == RV_CTL_DEVICE_LOST)
+      rv_transport_mark_lost(client->session->transport);
+   return 0;
+}
