+/* SPDX-License-Identifier: MIT */
+#include "rv_pm.h"
+#include "rv_runtime.h"
+#include "virtio/virtio-gpu/venus_hw.h"
+#include "c11/threads.h"
+#include "util/os_misc.h"
+#include "util/log.h"
+#include "vn_instance.h"
+#include "vn_renderer_internal.h"
+#include "vn_cs.h"
+#include "vn_protocol_driver_transport.h"
+#include "rv_client.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <sys/mman.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct darwin_shmem {
+   struct vn_renderer_shmem base;
+   struct rv_lease_desc lease;
+};
+
+struct darwin_sync {
+   struct vn_renderer_sync base;
+   uint64_t value;
+   uint64_t fence_epoch;
+   struct darwin_sync **pending_slot;
+   uint64_t pending_serial;
+   uint32_t pending_ring;
+};
+
+struct darwin_bo {
+   struct vn_renderer_bo base;
+   struct rv_lease_desc lease;
+   VkMemoryPropertyFlags memory_flags;
+};
+
+struct darwin_renderer {
+   struct vn_renderer base;
+   struct vn_instance *instance;
+   struct rv_client client;
+   mtx_t mutex;
+   bool async_fences;
+   bool power_control;
+   bool fence_epochs;
+   bool pipeline_streams;
+   uint64_t fence_serial;
+   uint64_t queue_decode[RV_CTL_MAX_QUEUES];
+   bool sync_used[RV_CTL_MAX_SYNCS];
+   /* Keep one guest slot free for a submit that also signals semaphores. */
+   struct darwin_sync *pending_fences[RV_CTL_MAX_QUEUES][RV_RING_SIZE - 1];
+   struct vn_renderer_shmem_cache shmem_cache;
+};
+
+static struct darwin_renderer *
+to_darwin(struct vn_renderer *renderer)
+{
+   return (struct darwin_renderer *)renderer;
+}
+
+static VkResult
+darwin_vk_result_from_status(int32_t status)
+{
+   switch (status) {
+   case RV_CTL_OK:
+      return VK_SUCCESS;
+   case RV_CTL_TIMEOUT:
+      return VK_TIMEOUT;
+   case RV_CTL_DEVICE_LOST:
+      return VK_ERROR_DEVICE_LOST;
+   case RV_CTL_OUT_OF_SPACE:
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   default:
+      return VK_ERROR_UNKNOWN;
+   }
+}
+
+static bool
+darwin_is_lost(struct vn_renderer *renderer)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   return (darwin->power_control && rv_pm_failed()) ||
+      !rv_transport_is_live(darwin->client.session->transport);
+}
+
+static void
+darwin_mark_lost(struct vn_renderer *renderer)
+{
+   rv_transport_mark_lost(to_darwin(renderer)->client.session->transport);
+}
+
+static uint32_t
+timeout_ms(uint64_t ns)
+{
+   if (ns == UINT64_MAX)
+      return UINT32_MAX;
+   const uint64_t ms = ns > UINT64_MAX - 999999 ? UINT64_MAX :
+                       (ns + 999999) / 1000000;
+   return ms > UINT32_MAX ? UINT32_MAX : (uint32_t)ms;
+}
+
+static void
+darwin_observe_sync(struct darwin_sync *sync, uint64_t value)
+{
+   if (value > sync->value)
+      sync->value = value;
+   if (sync->pending_slot && value > sync->fence_epoch) {
+      *sync->pending_slot = NULL;
+      sync->pending_slot = NULL;
+   }
+}
+
+static void
+darwin_observe_fence(struct darwin_renderer *darwin,
+                     struct darwin_sync *sync, uint64_t value)
+{
+   if (!sync->pending_slot || value <= sync->fence_epoch) {
+      darwin_observe_sync(sync, value);
+      return;
+   }
+
+   const uint64_t serial = sync->pending_serial;
+   struct darwin_sync **slots = darwin->pending_fences[sync->pending_ring];
+   for (uint32_t i = 0; i < RV_RING_SIZE - 1; i++) {
+      if (slots[i] && slots[i]->pending_serial <= serial)
+         darwin_observe_sync(slots[i], slots[i]->fence_epoch + 1);
+   }
+}
+
+/* The caller holds the renderer mutex and owns the fence's host lifetime. */
+static VkResult
+darwin_finish_fence_locked(struct darwin_renderer *darwin,
+                           struct darwin_sync *sync, uint32_t timeout)
+{
+   if (!sync->pending_slot)
+      return VK_SUCCESS;
+   const struct rv_gpu_wait wait = {
+      .count = 1,
+      .timeout_ms = timeout,
+      .conditions = {{ .queue = sync->base.sync_id, .value = sync->fence_epoch + 1 }},
+   };
+   int32_t status;
+   if (rv_client_wait_gpu(&darwin->client, &wait, &status))
+      return VK_ERROR_DEVICE_LOST;
+   if (status == RV_CTL_OK)
+      darwin_observe_fence(darwin, sync, wait.conditions[0].value);
+   return darwin_vk_result_from_status(status);
+}
+
+static VkResult
+darwin_submit_fence(struct darwin_renderer *darwin,
+                    const struct rv_stream_desc *stream,
+                    struct darwin_sync *sync, const void *cs_data, size_t cs_size)
+{
+   mtx_lock(&darwin->mutex);
+   struct darwin_sync **slots = darwin->pending_fences[stream->ring_idx];
+   struct darwin_sync **slot = NULL;
+   for (uint32_t i = 0; i < RV_RING_SIZE - 1; i++) {
+      if (!slots[i]) {
+         slot = &slots[i];
+         break;
+      }
+   }
+   VkResult result = VK_SUCCESS;
+   if (!slot) {
+      slot = &slots[0];
+      for (uint32_t i = 1; i < RV_RING_SIZE - 1; i++) {
+         if (slots[i]->pending_serial < (*slot)->pending_serial)
+            slot = &slots[i];
+      }
+      result = darwin_finish_fence_locked(darwin, *slot, UINT32_MAX);
+   }
+   if (result == VK_SUCCESS) {
+      struct rv_ticket ticket = {0};
+      int submitted = sync->pending_slot || darwin->fence_serial == UINT64_MAX ? -1 : 1;
+      if (submitted > 0 && darwin->pipeline_streams)
+         submitted = rv_client_defer_stream(&darwin->client, stream, cs_data, cs_size, &ticket);
+      if (submitted > 0) {
+         struct rv_ctl_reply reply;
+         submitted = rv_client_submit_stream(&darwin->client, stream, cs_data, cs_size, &reply);
+      }
+      if (submitted) {
+         result = VK_ERROR_DEVICE_LOST;
+      } else {
+         *slot = sync;
+         sync->pending_slot = slot;
+         sync->pending_serial = ++darwin->fence_serial;
+         sync->pending_ring = stream->ring_idx;
+         __atomic_store_n(&darwin->queue_decode[stream->ring_idx], ticket.sequence,
+                          __ATOMIC_RELEASE);
+      }
+   }
+   mtx_unlock(&darwin->mutex);
+   return result;
+}
+
+static VkResult
+darwin_wait_queue_decode(struct vn_renderer *renderer, uint32_t ring_idx)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   if (ring_idx >= RV_CTL_MAX_QUEUES)
+      return VK_ERROR_DEVICE_LOST;
+   const struct rv_ticket ticket = {
+      .sequence = __atomic_load_n(&darwin->queue_decode[ring_idx], __ATOMIC_ACQUIRE),
+   };
+   if (ticket.sequence && rv_transport_wait_stream(darwin->client.session->transport, ticket))
+      return VK_ERROR_DEVICE_LOST;
+   return VK_SUCCESS;
+}
+
+static void
+darwin_destroy(struct vn_renderer *renderer,
+               const VkAllocationCallbacks *alloc)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   RV_PM_SCOPE(pm);
+   (void)rv_pm_enter(&pm, RV_PM_INFINITE);
+   vn_renderer_shmem_cache_fini(&darwin->shmem_cache);
+   rv_client_close(&darwin->client);
+   rv_pm_leave(&pm);
+   if (darwin->power_control)
+      rv_pm_disconnect();
+   mtx_destroy(&darwin->mutex);
+   vk_free(alloc, darwin);
+}
+
+static struct vn_renderer_shmem *
+darwin_shmem_create(struct vn_renderer *renderer, size_t size)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct vn_renderer_shmem *cached =
+      vn_renderer_shmem_cache_get(&darwin->shmem_cache, size);
+   if (cached) {
+      cached->refcount = VN_REFCOUNT_INIT(1);
+      return cached;
+   }
+
+   struct darwin_shmem *shmem = vk_zalloc(
+      &darwin->instance->base.vk.alloc, sizeof(*shmem), VN_DEFAULT_ALIGN,
+      VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!shmem)
+      return NULL;
+
+   void *map = NULL;
+   if (rv_client_alloc_lease(&darwin->client, size, RV_LEASE_REPLY,
+                             &shmem->lease, &map)) {
+      vk_free(&darwin->instance->base.vk.alloc, shmem);
+      return NULL;
+   }
+   memset(map, 0, shmem->lease.length);
+   shmem->base = (struct vn_renderer_shmem){
+      .refcount = VN_REFCOUNT_INIT(1),
+      .res_id = (uint32_t)shmem->lease.resource_id,
+      .mmap_size = shmem->lease.length,
+      .mmap_ptr = map,
+   };
+   return &shmem->base;
+}
+
+static void
+darwin_shmem_destroy_now(struct vn_renderer *renderer,
+                         struct vn_renderer_shmem *_shmem)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct darwin_shmem *shmem = (struct darwin_shmem *)_shmem;
+   rv_client_release_lease(&darwin->client, &shmem->lease);
+   vk_free(&darwin->instance->base.vk.alloc, shmem);
+}
+
+static void
+darwin_shmem_destroy(struct vn_renderer *renderer,
+                     struct vn_renderer_shmem *shmem)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   if (vn_renderer_shmem_cache_add(&darwin->shmem_cache, shmem))
+      return;
+   darwin_shmem_destroy_now(renderer, shmem);
+}
+
+static VkResult
+darwin_submit(struct vn_renderer *renderer,
+              const struct vn_renderer_submit_batch *batch)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   if (darwin_is_lost(renderer) ||
+       !!batch->cs_data != !!batch->cs_size || batch->cs_size & 3 ||
+       batch->ring_idx >= RV_CTL_MAX_QUEUES ||
+       batch->sync_count > RV_CTL_MAX_WAIT_CONDITIONS)
+      return VK_ERROR_DEVICE_LOST;
+
+   const void *cs_data = batch->cs_data;
+   size_t cs_size = batch->cs_size;
+   uint32_t empty_cs_data[32];
+   struct vn_cs_encoder empty_cs;
+   if (!cs_data) {
+      /* A fence-only empty submit has no ring command to wait on. Still send
+       * one zero-size stream so the guest schedules its queue fence through
+       * the usual stream/fence path. vkr skips zero-size streams before
+       * looking up the resource ID.
+       */
+      const VkCommandStreamDescriptionMESA empty_stream = {
+         .resourceId = 0,
+         .offset = 0,
+         .size = 0,
+      };
+      empty_cs = VN_CS_ENCODER_INITIALIZER_LOCAL(empty_cs_data,
+                                                  sizeof(empty_cs_data));
+      vn_encode_vkExecuteCommandStreamsMESA(&empty_cs, 0, 1, &empty_stream,
+                                            NULL, 0, NULL, 0);
+      cs_data = empty_cs_data;
+      cs_size = vn_cs_encoder_get_len(&empty_cs);
+   }
+
+   struct rv_stream_desc stream = {
+      .generation = darwin->client.generation,
+      .ring_idx = batch->ring_idx,
+      .sync_count = batch->sync_count,
+   };
+   for (uint32_t i = 0; i < batch->sync_count; i++) {
+      if (!batch->syncs[i] || batch->syncs[i]->sync_id >= RV_CTL_MAX_SYNCS)
+         return VK_ERROR_DEVICE_LOST;
+      stream.syncs[i].sync_id = batch->syncs[i]->sync_id;
+      const struct darwin_sync *sync = (const struct darwin_sync *)batch->syncs[i];
+      stream.syncs[i].value = batch->sync_values[i] + sync->fence_epoch;
+   }
+
+   if (darwin->pipeline_streams && batch->ring_notification &&
+       !batch->sync_count && !batch->ring_idx) {
+      const int posted = rv_client_defer_stream(&darwin->client, &stream, cs_data, cs_size,
+                                               NULL);
+      if (posted <= 0)
+         return posted ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+   }
+
+   if (darwin->async_fences && batch->ring_idx && batch->fence_only)
+      return darwin_submit_fence(darwin, &stream,
+                                 (struct darwin_sync *)batch->syncs[0],
+                                 cs_data, cs_size);
+
+   struct rv_ctl_reply reply;
+   if (rv_client_submit_stream(&darwin->client, &stream, cs_data, cs_size,
+                               &reply))
+      return VK_ERROR_DEVICE_LOST;
+   if (!batch->sync_count)
+      return VK_SUCCESS;
+
+   if (!batch->ring_idx) {
+      mtx_lock(&darwin->mutex);
+      for (uint32_t i = 0; i < batch->sync_count; i++)
+         darwin_observe_sync((struct darwin_sync *)batch->syncs[i],
+                             stream.syncs[i].value);
+      mtx_unlock(&darwin->mutex);
+      return VK_SUCCESS;
+   }
+
+   struct rv_gpu_wait wait = {
+      .wait_any = 0,
+      .count = batch->sync_count,
+      .timeout_ms = UINT32_MAX,
+   };
+   for (uint32_t i = 0; i < batch->sync_count; i++) {
+      wait.conditions[i].queue = batch->syncs[i]->sync_id;
+      wait.conditions[i].value = stream.syncs[i].value;
+   }
+   int32_t status = RV_CTL_INVALID;
+   if (rv_client_wait_gpu(&darwin->client, &wait, &status))
+      return VK_ERROR_DEVICE_LOST;
+   VkResult result = darwin_vk_result_from_status(status);
+   if (result == VK_SUCCESS) {
+      mtx_lock(&darwin->mutex);
+      for (uint32_t i = 0; i < batch->sync_count; i++) {
+         struct darwin_sync *sync =
+            (struct darwin_sync *)batch->syncs[i];
+         darwin_observe_sync(sync, stream.syncs[i].value);
+      }
+      mtx_unlock(&darwin->mutex);
+   }
+   return result;
+}
+
+static VkResult
+darwin_wait(struct vn_renderer *renderer, const struct vn_renderer_wait *wait)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   if (darwin_is_lost(renderer) || !wait->sync_count)
+      return VK_ERROR_DEVICE_LOST;
+   struct rv_gpu_wait request = {
+      .wait_any = wait->wait_any,
+      .timeout_ms = timeout_ms(wait->timeout),
+   };
+   struct darwin_sync *requested_syncs[RV_CTL_MAX_WAIT_CONDITIONS];
+   mtx_lock(&darwin->mutex);
+   for (uint32_t i = 0; i < wait->sync_count; i++) {
+      if (!wait->syncs[i] || wait->syncs[i]->sync_id >= RV_CTL_MAX_SYNCS) {
+         mtx_unlock(&darwin->mutex);
+         return VK_ERROR_DEVICE_LOST;
+      }
+      struct darwin_sync *sync = (struct darwin_sync *)wait->syncs[i];
+      const uint64_t value = wait->sync_values[i];
+      const uint64_t target = value ? value + sync->fence_epoch : 0;
+      if (sync->value >= target) {
+         if (wait->wait_any) {
+            mtx_unlock(&darwin->mutex);
+            return VK_SUCCESS;
+         }
+         continue;
+      }
+      if (request.count < RV_CTL_MAX_WAIT_CONDITIONS) {
+         request.conditions[request.count].queue = sync->base.sync_id;
+         request.conditions[request.count].value = target;
+         requested_syncs[request.count] = sync;
+      }
+      request.count++;
+   }
+   mtx_unlock(&darwin->mutex);
+   if (!request.count)
+      return VK_SUCCESS;
+   if (request.count > RV_CTL_MAX_WAIT_CONDITIONS)
+      return VK_ERROR_DEVICE_LOST;
+   int32_t status = RV_CTL_INVALID;
+   if (rv_client_wait_gpu(&darwin->client, &request, &status))
+      return VK_ERROR_DEVICE_LOST;
+   VkResult result = darwin_vk_result_from_status(status);
+   if (result == VK_SUCCESS && (!wait->wait_any || wait->sync_count == 1)) {
+      mtx_lock(&darwin->mutex);
+      for (uint32_t i = 0; i < request.count; i++)
+         darwin_observe_fence(darwin, requested_syncs[i], request.conditions[i].value);
+      mtx_unlock(&darwin->mutex);
+   }
+   return result;
+}
+
+static VkResult
+darwin_bo_create_from_device_memory(struct vn_renderer *renderer,
+                                    struct vn_renderer_submit_batch *batch,
+                                    VkDeviceSize size, vn_object_id mem_id,
+                                    VkMemoryPropertyFlags flags,
+                                    VkExternalMemoryHandleTypeFlags handles,
+                                    struct vn_renderer_bo **out_bo)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   (void)handles;
+   *out_bo = NULL;
+   if (!darwin->client.has_guest_vram)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   if ((flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) &&
+       !(flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   if (size > SIZE_MAX)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   /* Preserve the ring ordering required by Mesa's allocation path. */
+   if (batch && batch->cs_size) {
+      VkResult result = darwin_submit(renderer, batch);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   struct darwin_bo *bo = vk_zalloc(
+      &darwin->instance->base.vk.alloc, sizeof(*bo), VN_DEFAULT_ALIGN,
+      VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   if (rv_client_alloc_vram(&darwin->client, size, &bo->lease)) {
+      vk_free(&darwin->instance->base.vk.alloc, bo);
+      return errno == ENOMEM ? VK_ERROR_OUT_OF_HOST_MEMORY :
+                              VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+   bo->base = (struct vn_renderer_bo){
+      .refcount = VN_REFCOUNT_INIT(1),
+      .res_id = (uint32_t)bo->lease.resource_id,
+      .mmap_size = bo->lease.length,
+   };
+   bo->memory_flags = flags;
+   *out_bo = &bo->base;
+   (void)mem_id;
+   return VK_SUCCESS;
+}
+
+static void *
+darwin_bo_map(struct vn_renderer *renderer, struct vn_renderer_bo *_bo,
+              void *placed_addr)
+{
+   struct darwin_renderer *darwin = to_darwin(renderer);
+   struct darwin_bo *bo = (struct darwin_bo *)_bo;
+   if (!(bo->memory_flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+      return NULL;
+   if (!bo->base.mmap_ptr) {
+      int flags = MAP_SHARED;
+      if (placed_addr)
+         flags |= MAP_FIXED;
+      void *ptr = mmap(placed_addr, bo->base.mmap_size,
+                       PROT_READ | PROT_WRITE, flags,
+                       darwin->client.vram_fd, (off_t)bo->lease.offset);
+      if (ptr == MAP_FAILED)
+         return NULL;
+      bo->base.mmap_ptr = ptr;
+   }
+   return bo->base.mmap_ptr;
+}
