+#ifndef RV_PM_H
+#define RV_PM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdatomic.h>
+
+#define RV_PM_MAGIC UINT32_C(0x4d505652)
+#define RV_PM_VERSION 1
+#define RV_PM_INFINITE UINT64_MAX
+
+enum rv_pm_opcode {
+   RV_PM_HELLO = 1,
+   RV_PM_HELLO_ACK,
+   RV_PM_PREPARE,
+   RV_PM_DRAINED,
+   RV_PM_QUIESCED,
+   RV_PM_RESUME,
+   RV_PM_ABORT,
+   RV_PM_READY,
+   RV_PM_FAILED,
+};
+
+struct rv_pm_frame {
+   uint32_t magic;
+   uint16_t version;
+   uint16_t opcode;
+   uint64_t cookie;
+   uint64_t transition;
+   uint32_t status;
+   uint32_t reserved;
+};
+
+_Static_assert(sizeof(struct rv_pm_frame) == 32, "RVPM v1 frame");
+
+struct rv_pm_scope {
+   bool held;
+};
+
+#ifdef __APPLE__
+extern _Atomic bool rv_pm_enabled;
+
+int rv_pm_connect(const char *path);
+bool rv_pm_failed(void);
+void rv_pm_disconnect(void);
+int rv_pm_enter_slow(struct rv_pm_scope *scope, uint64_t timeout_ns);
+void rv_pm_leave(struct rv_pm_scope *scope);
+bool rv_pm_reserve(void);
+void rv_pm_release_reserved(void);
+void rv_pm_adopt(struct rv_pm_scope *scope, bool reserved);
+
+static inline int
+rv_pm_enter(struct rv_pm_scope *scope, uint64_t timeout_ns)
+{
+   return atomic_load_explicit(&rv_pm_enabled, memory_order_relaxed)
+      ? rv_pm_enter_slow(scope, timeout_ns) : 0;
+}
+
+#else
+static inline int
+rv_pm_enter(struct rv_pm_scope *scope, uint64_t timeout_ns)
+{
+   (void)scope;
+   (void)timeout_ns;
+   return 0;
+}
+
+static inline bool
+rv_pm_reserve(void)
+{
+   return false;
+}
+
+static inline void
+rv_pm_adopt(struct rv_pm_scope *scope, bool reserved)
+{
+   (void)scope;
+   (void)reserved;
+}
+
+static inline void
+rv_pm_leave(struct rv_pm_scope *scope)
+{
+   (void)scope;
+}
+#endif
+
+static inline void
+rv_pm_scope_cleanup(struct rv_pm_scope *scope)
+{
+   if (scope->held)
+      rv_pm_leave(scope);
+}
+
+#define RV_PM_SCOPE(name) \
+   struct rv_pm_scope name __attribute__((cleanup(rv_pm_scope_cleanup))) = {0}
+
+#endif
