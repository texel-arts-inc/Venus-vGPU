+#include "rv_pm.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error RVPM v1 requires little-endian frame encoding
+#endif
+
+enum gate_state {
+   GATE_RUNNING,
+   GATE_DRAINING,
+   GATE_DRAINED,
+   GATE_WAIT_READY,
+   GATE_FAILED,
+};
+
+_Atomic bool rv_pm_enabled;
+static pthread_mutex_t lifetime = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static pthread_t thread;
+static unsigned connections;
+static _Atomic bool failed;
+static char connected_path[sizeof(((struct sockaddr_un *)0)->sun_path)];
+static unsigned admitted;
+static _Thread_local unsigned depth;
+static int peer = -1;
+static int wake_fds[2] = {-1, -1};
+static uint64_t cookie;
+static uint64_t transition;
+static enum gate_state state;
+
+static uint64_t
+now_ns(void)
+{
+   struct timespec now;
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   return (uint64_t)now.tv_sec * 1000000000 + now.tv_nsec;
+}
+
+static int
+wait_fd(int fd, short events, uint64_t deadline)
+{
+   struct pollfd entry = {.fd = fd, .events = events};
+   for (;;) {
+      uint64_t now = now_ns();
+      if (now >= deadline)
+         return ETIMEDOUT;
+      uint64_t ms = (deadline - now) / 1000000 + 1;
+      int rc = poll(&entry, 1, ms > INT_MAX ? INT_MAX : (int)ms);
+      if (rc > 0)
+         return entry.revents & events ? 0 : EPIPE;
+      if (rc < 0 && errno != EINTR)
+         return errno;
+   }
+}
+
+static int
+transfer_frame(struct rv_pm_frame *frame, bool sending)
+{
+   char *bytes = (char *)frame;
+   uint64_t deadline = now_ns() + UINT64_C(5000000000);
+   size_t offset = 0;
+   while (offset < sizeof(*frame)) {
+      int error = wait_fd(peer, sending ? POLLOUT : POLLIN, deadline);
+      if (error)
+         return error;
+      size_t remaining = sizeof(*frame) - offset;
+      ssize_t rc = sending
+         ? send(peer, bytes + offset, remaining, 0)
+         : recv(peer, bytes + offset, remaining, 0);
+      if (rc < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK))
+         continue;
+      if (rc <= 0)
+         return rc == 0 ? EPIPE : errno;
+      offset += (size_t)rc;
+   }
+   return 0;
+}
+
+static bool
+valid_frame(const struct rv_pm_frame *frame)
+{
+   return frame->magic == RV_PM_MAGIC && frame->version == RV_PM_VERSION &&
+          !frame->reserved;
+}
+
+static int
+send_frame(enum rv_pm_opcode opcode, uint64_t id)
+{
+   struct rv_pm_frame frame = {
+      .magic = RV_PM_MAGIC,
+      .version = RV_PM_VERSION,
+      .opcode = opcode,
+      .cookie = cookie,
+      .transition = id,
+   };
+   return transfer_frame(&frame, true);
+}
+
+static int
+receive_transition(void)
+{
+   struct rv_pm_frame frame;
+   int error = transfer_frame(&frame, false);
+   if (error)
+      return error;
+   if (!valid_frame(&frame) || frame.cookie != cookie || !frame.transition)
+      return EPROTO;
+
+   pthread_mutex_lock(&mutex);
+   if (frame.opcode == RV_PM_PREPARE && state == GATE_RUNNING &&
+       !frame.status && frame.transition > transition) {
+      transition = frame.transition;
+      state = GATE_DRAINING;
+   } else if (frame.transition == transition) {
+      switch (frame.opcode) {
+      case RV_PM_ABORT:
+         if (!frame.status && state != GATE_RUNNING)
+            state = GATE_WAIT_READY;
+         break;
+      case RV_PM_RESUME:
+         if (!frame.status && state == GATE_DRAINED)
+            state = GATE_WAIT_READY;
+         break;
+      case RV_PM_READY:
+         if (!frame.status && state == GATE_WAIT_READY) {
+            state = GATE_RUNNING;
+            pthread_cond_broadcast(&changed);
+         }
+         break;
+      case RV_PM_FAILED:
+         if (state != GATE_RUNNING)
+            error = EPIPE;
+         break;
+      default:
+         break;
+      }
+   }
+   pthread_mutex_unlock(&mutex);
+   return error;
+}
+
+static void *
+control_thread(void *unused)
+{
+   (void)unused;
+   for (;;) {
+      struct pollfd entries[2] = {
+         {.fd = peer, .events = POLLIN},
+         {.fd = wake_fds[0], .events = POLLIN},
+      };
+      int rc = poll(entries, 2, -1);
+      if (rc < 0 && errno == EINTR)
+         continue;
+      if (rc < 0 || (entries[0].revents && receive_transition()))
+         break;
+      if (entries[1].revents & POLLIN) {
+         char bytes[32];
+         while (read(wake_fds[0], bytes, sizeof(bytes)) > 0)
+            ;
+      }
+
+      uint64_t drained = 0;
+      pthread_mutex_lock(&mutex);
+      if (state == GATE_DRAINING && !admitted) {
+         state = GATE_DRAINED;
+         drained = transition;
+      }
+      pthread_mutex_unlock(&mutex);
+      if (drained && send_frame(RV_PM_DRAINED, drained))
+         break;
+   }
+
+   pthread_mutex_lock(&mutex);
+   state = GATE_FAILED;
+   atomic_store_explicit(&failed, true, memory_order_release);
+   pthread_cond_broadcast(&changed);
+   pthread_mutex_unlock(&mutex);
+   return NULL;
+}
+
+static int
+configure_fd(int fd)
+{
+   if (fcntl(fd, F_SETFD, FD_CLOEXEC) < 0 || fcntl(fd, F_SETFL, O_NONBLOCK) < 0)
+      return errno;
+   return 0;
+}
+
+static void
+close_fds(void)
+{
+   if (peer >= 0)
+      close(peer);
+   peer = -1;
+   for (unsigned i = 0; i < 2; i++) {
+      if (wake_fds[i] >= 0)
+         close(wake_fds[i]);
+      wake_fds[i] = -1;
+   }
+}
+
+int
+rv_pm_connect(const char *path)
+{
+   struct sockaddr_un address = {.sun_family = AF_UNIX};
+   if (!path || !*path || strlen(path) >= sizeof(address.sun_path))
+      return EINVAL;
+   strcpy(address.sun_path, path);
+
+   pthread_mutex_lock(&lifetime);
+   if (connections) {
+      pthread_mutex_lock(&mutex);
+      int error = state == GATE_FAILED ? EPIPE :
+         strcmp(path, connected_path) ? EBUSY : 0;
+      if (!error)
+         connections++;
+      pthread_mutex_unlock(&mutex);
+      pthread_mutex_unlock(&lifetime);
+      return error;
+   }
+
+   int error = 0;
+   peer = socket(AF_UNIX, SOCK_STREAM, 0);
+   if (peer < 0) {
+      error = errno;
+      goto out;
+   }
+#if defined(SO_NOSIGPIPE)
+   const int no_sigpipe = 1;
+   if (setsockopt(peer, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe))) {
+      error = errno;
+      goto out;
+   }
+#endif
+   error = configure_fd(peer);
+   if (error)
+      goto out;
+   if (connect(peer, (struct sockaddr *)&address, sizeof(address))) {
+      if (errno != EINPROGRESS) {
+         error = errno;
+         goto out;
+      }
+      error = wait_fd(peer, POLLOUT, now_ns() + UINT64_C(5000000000));
+      if (error)
+         goto out;
+      socklen_t length = sizeof(error);
+      if (getsockopt(peer, SOL_SOCKET, SO_ERROR, &error, &length))
+         error = errno;
+      if (error)
+         goto out;
+   }
+
+   struct rv_pm_frame reply;
+   cookie = 0;
+   if ((error = send_frame(RV_PM_HELLO, 0)) ||
+       (error = transfer_frame(&reply, false)))
+      goto out;
+   if (!valid_frame(&reply) || reply.opcode != RV_PM_HELLO_ACK ||
+       !reply.cookie || reply.transition || reply.status) {
+      error = EPROTO;
+      goto out;
+   }
+   cookie = reply.cookie;
+
+   if (pipe(wake_fds)) {
+      error = errno;
+      goto out;
+   }
+   if ((error = configure_fd(wake_fds[0])) || (error = configure_fd(wake_fds[1])))
+      goto out;
+   state = GATE_RUNNING;
+   atomic_store_explicit(&failed, false, memory_order_release);
+   transition = 0;
+   strcpy(connected_path, path);
+   error = pthread_create(&thread, NULL, control_thread, NULL);
+   if (!error) {
+      connections = 1;
+      atomic_store_explicit(&rv_pm_enabled, true, memory_order_release);
+   }
+
+out:
+   if (error)
+      close_fds();
+   pthread_mutex_unlock(&lifetime);
+   return error;
+}
+
+bool
+rv_pm_failed(void)
+{
+   return atomic_load_explicit(&failed, memory_order_acquire);
+}
+
+void
+rv_pm_disconnect(void)
+{
+   pthread_mutex_lock(&lifetime);
+   assert(connections);
+   if (!--connections) {
+      shutdown(peer, SHUT_RDWR);
+      pthread_join(thread, NULL);
+      atomic_store_explicit(&rv_pm_enabled, false, memory_order_release);
+      close_fds();
+   }
+   pthread_mutex_unlock(&lifetime);
+}
+
+int
+rv_pm_enter_slow(struct rv_pm_scope *scope, uint64_t timeout_ns)
+{
+   if (depth) {
+      depth++;
+      scope->held = true;
+      return 0;
+   }
+
+   uint64_t start = now_ns();
+   pthread_mutex_lock(&mutex);
+   int error = 0;
+   while (state != GATE_RUNNING && state != GATE_FAILED) {
+      if (timeout_ns == RV_PM_INFINITE) {
+         error = pthread_cond_wait(&changed, &mutex);
+      } else {
+         uint64_t elapsed = now_ns() - start;
+         if (elapsed >= timeout_ns) {
+            error = ETIMEDOUT;
+            break;
+         }
+         uint64_t ns = timeout_ns - elapsed;
+         const struct timespec delay = {.tv_sec = ns / 1000000000,
+                                       .tv_nsec = ns % 1000000000};
+         error = pthread_cond_timedwait_relative_np(&changed, &mutex, &delay);
+      }
+      if (error)
+         break;
+   }
+   if (!error && state == GATE_FAILED)
+      error = EPIPE;
+   if (!error) {
+      admitted++;
+      depth = 1;
+      scope->held = true;
+   }
+   pthread_mutex_unlock(&mutex);
+   return error;
+}
+
+void
+rv_pm_release_reserved(void)
+{
+   pthread_mutex_lock(&mutex);
+   assert(admitted);
+   if (!--admitted && state == GATE_DRAINING) {
+      ssize_t result;
+      do {
+         result = write(wake_fds[1], "d", 1);
+      } while (result < 0 && errno == EINTR);
+   }
+   pthread_mutex_unlock(&mutex);
+}
+
+void
+rv_pm_leave(struct rv_pm_scope *scope)
+{
+   if (!scope->held)
+      return;
+   scope->held = false;
+   assert(depth);
+   if (!--depth)
+      rv_pm_release_reserved();
+}
+
+bool
+rv_pm_reserve(void)
+{
+   if (!depth)
+      return false;
+   pthread_mutex_lock(&mutex);
+   admitted++;
+   pthread_mutex_unlock(&mutex);
+   return true;
+}
+
+void
+rv_pm_adopt(struct rv_pm_scope *scope, bool reserved)
+{
+   if (reserved) {
+      assert(!depth);
+      depth = 1;
+      scope->held = true;
+   }
+}
