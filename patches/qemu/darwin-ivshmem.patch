+/*
+ * Darwin passes a nonblocking, read/write FIFO descriptor in the same
+ * protocol slot as Linux eventfd. Unlink it before passing it to peers.
+ */
+static int ivshmem_vector_init(EventNotifier *vector)
+{
+#ifdef __APPLE__
+    char directory[] = "/tmp/ivshmem-vector.XXXXXX";
+    int fd = -1;
+
+    if (!mkdtemp(directory)) {
+        return -errno;
+    }
+    g_autofree char *path = g_build_filename(directory, "notify", NULL);
+    if (mkfifo(path, 0600) == 0) {
+        fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+        unlink(path);
+    }
+    rmdir(directory);
+    if (fd < 0) {
+        return -1;
+    }
+    event_notifier_init_fd(vector, fd);
+    return 0;
+#else
+    return event_notifier_init(vector, false);
+#endif
+}
+
 /* handle message on listening unix socket (new client connection) */
