+static bool apple_vfio_pm_read_pci(VFIOApplePCIDevice *adev, bool compare,
+                                  Error **errp)
+{
+    VFIOPCIDevice *vdev = VFIO_PCI_DEVICE(adev);
+    AppleVFIOState *apple = adev->apple;
+    io_connect_t conn = apple_vfio_connection(&vdev->vbasedev);
+    uint64_t identity;
+
+    if (conn == IO_OBJECT_NULL ||
+        apple_dext_config_read(conn, PCI_VENDOR_ID, 4, &identity) != KERN_SUCCESS ||
+        (identity & UINT16_MAX) == UINT16_MAX ||
+        (compare && identity != apple->pm_identity)) {
+        error_setg(errp, "vfio-apple: physical PCI function is unavailable or changed");
+        return false;
+    }
+    apple->pm_identity = identity;
+
+    for (int i = 0; i < PCI_ROM_SLOT; i++) {
+        AppleVFIOSleepBAR *saved = &apple->pm_bars[i];
+        AppleVFIOSleepBAR live = { .mapped = apple->bar_maps[i].addr != NULL };
+        uint64_t config;
+
+        if (apple_dext_config_read(conn, PCI_BASE_ADDRESS_0 + 4 * i, 4,
+                                   &config) != KERN_SUCCESS ||
+            (compare && config != apple->pm_bar_config[i])) {
+            error_setg(errp, "vfio-apple: physical BAR%d config changed", i);
+            return false;
+        }
+        apple->pm_bar_config[i] = config;
+        if (live.mapped && !apple_vfio_get_bar_info(adev, i, &live.memory_index,
+                                                   &live.size, &live.type)) {
+            error_setg(errp, "vfio-apple: could not validate BAR%d", i);
+            return false;
+        }
+        if (compare) {
+            if (saved->mapped != live.mapped || saved->size != live.size ||
+                saved->memory_index != live.memory_index || saved->type != live.type) {
+                error_setg(errp, "vfio-apple: DriverKit BAR%d mapping changed", i);
+                return false;
+            }
+        } else {
+            live.enabled = vdev->bars[i].mr && vdev->bars[i].mr->enabled;
+            *saved = live;
+        }
+    }
+    return true;
+}
 
+static bool apple_vfio_pm_read_dma(VFIOApplePCIDevice *adev, bool verify,
+                                  uint64_t state[4], Error **errp)
+{
+    io_connect_t conn = apple_vfio_connection(&VFIO_PCI_DEVICE(adev)->vbasedev);
+    kern_return_t result = conn == IO_OBJECT_NULL ? kIOReturnNotAttached :
+                          apple_dext_dma_checkpoint(conn, verify, state);
+
+    if (result != KERN_SUCCESS) {
+        error_setg(errp, "vfio-apple: DriverKit DMA checkpoint failed (%#x)", result);
+        return false;
+    }
+    return true;
+}
+
+static bool apple_vfio_pm_verify_dma(VFIOApplePCIDevice *adev, Error **errp)
+{
+    uint64_t state[4];
+
+    if (!apple_vfio_pm_read_dma(adev, true, state, errp)) {
+        return false;
+    }
+    if (memcmp(state, adev->apple->pm_dma_state, sizeof(state))) {
+        error_setg(errp, "vfio-apple: prepared DMA mapping inventory changed during sleep");
+        return false;
+    }
+    return true;
+}
+
+void apple_vfio_pm_emergency_gate(VFIOApplePCIDevice *adev)
+{
+    VFIOPCIDevice *vdev = VFIO_PCI_DEVICE(adev);
+    AppleVFIOState *apple = adev->apple;
+
+    if (!apple || apple->pm_gated) {
+        return;
+    }
+    apple->pm_gated = true;
+    memory_region_transaction_begin();
+    for (int i = 0; i < PCI_ROM_SLOT; i++) {
+        if (vdev->bars[i].mr) {
+            memory_region_set_enabled(vdev->bars[i].mr, false);
+        }
+    }
+    memory_region_transaction_commit();
+}
+
+bool apple_vfio_pm_gate(VFIOApplePCIDevice *adev, Error **errp)
+{
+    AppleVFIOState *apple = adev->apple;
+
+    if (!apple || !adev->parent_obj.vbasedev.bcontainer ||
+        !runstate_check(RUN_STATE_PAUSED) || apple->pm_gated) {
+        error_setg(errp, "vfio-apple: PM gate requires an attached device and paused VM");
+        return false;
+    }
+    if (!apple_vfio_pm_read_pci(adev, false, errp) ||
+        !apple_vfio_pm_read_dma(adev, false, apple->pm_dma_state, errp)) {
+        return false;
+    }
+    apple_vfio_pm_emergency_gate(adev);
+    return true;
+}
+
+bool apple_vfio_pm_validate_pci(VFIOApplePCIDevice *adev, Error **errp)
+{
+    if (!adev->apple || !adev->parent_obj.vbasedev.bcontainer ||
+        !runstate_check(RUN_STATE_PAUSED) || !adev->apple->pm_gated) {
+        error_setg(errp, "vfio-apple: PM validation requires a gated, paused device");
+        return false;
+    }
+    return apple_vfio_pm_read_pci(adev, true, errp);
+}
+
+void apple_vfio_pm_enable_after_dma_check(VFIOApplePCIDevice *adev)
+{
+    VFIOPCIDevice *vdev = VFIO_PCI_DEVICE(adev);
+    AppleVFIOState *apple = adev->apple;
+
+    assert(apple && apple->pm_gated && runstate_check(RUN_STATE_PAUSED));
+    memory_region_transaction_begin();
+    for (int i = 0; i < PCI_ROM_SLOT; i++) {
+        if (apple->pm_bars[i].enabled) {
+            memory_region_set_enabled(vdev->bars[i].mr, true);
+        }
+    }
+    memory_region_transaction_commit();
+    apple->pm_gated = false;
+    apple_vfio_update_irq_mask(&vdev->vbasedev);
+    event_notifier_set(&apple->irq_notifier);
+}
