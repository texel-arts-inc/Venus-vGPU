+queue_check(struct vkr_queue *queue, uint64_t transition, bool verify)
+{
+   const struct vkr_device *dev = queue->device;
+   const struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+   VkResult result;
+
+   if (queue->pm.transition) {
+      result = vk->GetFenceStatus(device, queue->pm.fence);
+      if (result != VK_SUCCESS)
+         return pm_result(result);
+      if (queue->pm.transition == transition && queue->pm.verify == verify) {
+         if (!verify)
+            return 0;
+         uint64_t timestamp;
+         result = vk->GetQueryPoolResults(device, queue->pm.query, 0, 1,
+                                          sizeof(timestamp), &timestamp,
+                                          sizeof(timestamp), VK_QUERY_RESULT_64_BIT);
+         if (result == VK_SUCCESS && !queue->pm.reported) {
+            vkr_log("Venus PM GPU timestamp transition=%" PRIu64 " family=%u queue=%u value=%" PRIu64,
+                    transition, queue->family, queue->index, timestamp);
+            queue->pm.reported = true;
+         }
+         return pm_result(result);
+      }
+   }
+
+   if (queue->pm.fence) {
+      result = vk->ResetFences(device, 1, &queue->pm.fence);
+   } else {
+      VkFence fence;
+      result = vk->CreateFence(device, &(VkFenceCreateInfo){
+         .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+      }, NULL, &fence);
+      if (result == VK_SUCCESS)
+         queue->pm.fence = fence;
+   }
+   if (result != VK_SUCCESS)
+      return pm_result(result);
+
+   queue->pm.transition = 0;
+   const VkSubmitInfo probe = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &queue->pm.command,
+   };
+   mtx_lock(&queue->vk_mutex);
+   result = vk->QueueSubmit(queue->base.handle.queue, verify ? 1 : 0,
+                            verify ? &probe : NULL, queue->pm.fence);
+   mtx_unlock(&queue->vk_mutex);
+   if (result != VK_SUCCESS)
+      return pm_result(result);
+   queue->pm.transition = transition;
+   queue->pm.verify = verify;
+   queue->pm.reported = false;
+   return EAGAIN;
+}
+
+static int
+check_rings(struct vkr_context *ctx)
+{
+   int error = 0;
+   mtx_lock(&ctx->ring_mutex);
+   list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+      uint32_t tail = atomic_load_explicit(ring->control.tail, memory_order_acquire);
+      if (vkr_ring_load_head(ring) != tail) {
+         error = EAGAIN;
+         break;
+      }
+   }
+   mtx_unlock(&ctx->ring_mutex);
+   return error;
+}
+
+static int
+check_device(struct vkr_device *dev, uint64_t transition, bool verify)
+{
+   struct vkr_queue *probe = NULL;
+   list_for_each_entry (struct vkr_queue, queue, &dev->queues, base.track_head) {
+      if (queue_can_probe(queue)) {
+         probe = queue;
+         break;
+      }
+   }
+   if (!probe)
+      return ENOTSUP;
+   if (!probe->pm.command) {
+      const int error = pm_result(queue_create_probe(probe));
+      if (error)
+         return error;
+   }
+   if (verify)
+      return queue_check(probe, transition, true);
+
+   int pending = 0;
+   list_for_each_entry (struct vkr_queue, queue, &dev->queues, base.track_head) {
+      int error = queue_check(queue, transition, false);
+      if (error && error != EAGAIN)
+         return error;
+      if (error)
+         pending = error;
+   }
+   return pending;
+}
+
+int
+vkr_context_pm_check(struct vkr_context *ctx, uint64_t transition, bool verify)
+{
+   if (vkr_context_get_fatal(ctx))
+      return ENODEV;
+   int error = check_rings(ctx);
+   if (error || !ctx->instance)
+      return error;
+
+   int pending = 0;
+   struct vkr_instance *instance = ctx->instance;
+   for (uint32_t i = 0; i < instance->physical_device_count; i++) {
+      struct vkr_physical_device *physical = instance->physical_devices[i];
+      if (!physical)
+         continue;
+      list_for_each_entry (struct vkr_device, dev, &physical->devices, base.track_head) {
+         error = check_device(dev, transition, verify);
+         if (error && error != EAGAIN)
+            return error;
+         if (error)
+            pending = error;
+      }
+   }
+   return pending;
+}
