+{
+   const struct vkr_device *dev = queue->device;
+   const struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+   VkQueryPool query;
+   VkResult result = vk->CreateQueryPool(device, &(VkQueryPoolCreateInfo){
+      .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+      .queryType = VK_QUERY_TYPE_TIMESTAMP,
+      .queryCount = 1,
+   }, NULL, &query);
+   if (result != VK_SUCCESS)
+      return result;
+   queue->pm.query = query;
+
+   VkCommandPool pool;
+   result = vk->CreateCommandPool(device, &(VkCommandPoolCreateInfo){
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = queue->family,
+   }, NULL, &pool);
+   if (result == VK_SUCCESS) {
+      queue->pm.pool = pool;
+      result = vk->AllocateCommandBuffers(device, &(VkCommandBufferAllocateInfo){
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = pool,
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      }, &queue->pm.command);
