+   switch (result) {
+   case VK_SUCCESS: return 0;
+   case VK_NOT_READY: return EAGAIN;
+   case VK_ERROR_DEVICE_LOST: return ENODEV;
+   case VK_ERROR_OUT_OF_DEVICE_MEMORY:
