+static bool
+queue_can_probe(const struct vkr_queue *queue)
+{
+   const struct vkr_physical_device *physical = queue->device->physical_device;
+   if (queue->flags || queue->family >= physical->queue_family_property_count)
+      return false;
+   const VkQueueFamilyProperties *family = &physical->queue_family_properties[queue->family];
+   return family->timestampValidBits &&
+      (family->queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT | VK_QUEUE_TRANSFER_BIT));
+}
+
+static void
+queue_free_probe(struct vkr_queue *queue)
+{
+   const struct vkr_device *dev = queue->device;
+   const struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+   if (queue->pm.pool)
+      vk->DestroyCommandPool(device, queue->pm.pool, NULL);
+   if (queue->pm.query)
+      vk->DestroyQueryPool(device, queue->pm.query, NULL);
+   queue->pm.pool = VK_NULL_HANDLE;
+   queue->pm.query = VK_NULL_HANDLE;
+   queue->pm.command = VK_NULL_HANDLE;
+}
+
+void
+vkr_queue_pm_fini(struct vkr_queue *queue)
+{
+   queue_free_probe(queue);
+   if (queue->pm.fence)
+      queue->device->proc_table.DestroyFence(queue->device->base.handle.device,
+                                           queue->pm.fence, NULL);
+}
+
+static VkResult
