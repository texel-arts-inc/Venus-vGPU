#!/bin/sh
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
set -eu

stage=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime="$stage/lib/ollama"

export VK_DRIVER_FILES="${VENUS_ICD:-/Library/Frameworks/Venus.framework/Resources/icd.d/Venus_icd.json}"
unset VK_ICD_FILENAMES VK_ADD_DRIVER_FILES
export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11435}"
export OLLAMA_MODELS="${OLLAMA_MODELS:-$stage/models}"
export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-4096}"
export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-1}"
export OLLAMA_NO_CLOUD=1
export OLLAMA_VULKAN=1
export OLLAMA_LLM_LIBRARY=vulkan
export GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM=1

if [ "${1:-}" = serve ]; then
    if ! devices=$(GGML_BACKEND_PATH="$runtime/vulkan/libggml-vulkan.so" \
        "$runtime/llama-server" --list-devices 2>&1) ||
        ! printf '%s\n' "$devices" | /usr/bin/grep -Eq 'Vulkan[0-9]+: .*Virtio-GPU Venus'; then
        printf '%s\n' "$devices" >&2
        printf '%s\n' 'Venus Vulkan device unavailable. Start the Venus guest and check VENUS_ICD.' >&2
        exit 1
    fi
fi

exec "$stage/bin/ollama" "$@"
